# Runner image for a Python Nest app. The base image is pinned by digest: review refuses a FROM that
# is not. No package install step: the app and its SDK copy use the standard library only.
ARG BASE_IMAGE=docker.io/library/python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY . /app
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/python3", "/app/app.py"]

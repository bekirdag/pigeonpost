meta {
  name: Claim key packages for pending adds
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/groups/:id/key-packages/claim
  body: json
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "request_key": "string",
    "mailboxes": []
  }
}

docs {
  See docs/groups.md. Requires the `groups` feature flag; human-only actions refuse automation with `human_required`.
}

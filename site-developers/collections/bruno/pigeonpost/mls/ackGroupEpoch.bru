meta {
  name: Highest epoch this device has processed
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/groups/:id/epoch-ack
  body: json
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "epoch": 0
  }
}

docs {
  See docs/groups.md. Requires the `groups` feature flag; human-only actions refuse automation with `human_required`.
}

meta {
  name: Delete a mailbox and its messages
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/v1/identities
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  An account credential may delete any mailbox it owns; a capability token may delete only its own mailbox.
}

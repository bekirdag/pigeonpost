meta {
  name: A fresh personal invitation link for a contact-address guest (organizer)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/calendar/events/:id/attendees/:attendee_id/link
  body: none
  auth: bearer
}

params:path {
  id: 
  attendee_id: 
}

auth:bearer {
  token: {{token}}
}

docs {
  See docs/calendar.md. Requires the `calendar` feature flag.
}

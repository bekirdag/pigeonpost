meta {
  name: Turn a secret feed on (new link, shown once) or off
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/v1/calendar/feeds/:calendar_id
  body: json
  auth: bearer
}

params:path {
  calendar_id: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {}
}

docs {
  See docs/calendar.md. Requires the `calendar` feature flag.
}

meta {
  name: Register a push token for the acting mailbox
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/devices
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "token": "string",
    "platform": "apns",
    "environment": "production",
    "identity": "string",
    "kind": "alert",
    "os": "ios"
  }
}

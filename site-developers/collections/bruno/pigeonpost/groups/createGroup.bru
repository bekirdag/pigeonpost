meta {
  name: Create a group (starts provisioning)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "request_key": "string",
    "name": "string",
    "description": "string",
    "join_policy": "string",
    "post_policy": "string",
    "stream_policy": "admins",
    "visibility": "string",
    "members_can_invite": false,
    "members_can_change_timer": false,
    "ephemeral_secs": 0,
    "invite": []
  }
}

docs {
  See docs/groups.md. Requires the `groups` feature flag; human-only actions refuse automation with `human_required`.
}

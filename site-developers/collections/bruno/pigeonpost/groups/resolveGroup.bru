meta {
  name: Preview a group from an id and optional link token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/groups/resolve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "group_id": "string",
    "link_token": "string"
  }
}

docs {
  See docs/groups.md. Requires the `groups` feature flag; human-only actions refuse automation with `human_required`.
}

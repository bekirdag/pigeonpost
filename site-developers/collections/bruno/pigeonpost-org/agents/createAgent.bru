meta {
  name: Create an agent
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/agents
  body: json
  auth: bearer
}

headers {
  ~Idempotency-Key: replace-with-a-unique-key
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "handle": "ci-bot",
    "label": "CI runner"
  }
}

docs {
  Creates an org agent mailbox. It has no device yet: a person issues an enrollment code (or approves a device login) to bring a machine up as this agent. The API cannot issue codes or credentials.

  Scope: `agents:write`.

  Errors: `invalid_handle` (400), `bad_request` (400), `unauthorized` (401), `ip_not_allowed` (403), `insufficient_scope` (403), `forbidden` (403), `feature_disabled` (404), `agent_limit` (409), `handle_taken` (409), `org_inactive` (409), `org_read_only` (409), `idempotency_conflict` (409), `rate_limited` (429), `store_error` (500).
}

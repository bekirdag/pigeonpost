meta {
  name: List an agent's enrollment codes
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/agents/:agent/enrollments
  body: none
  auth: bearer
}

params:path {
  agent: ci-bot
}

auth:bearer {
  token: {{token}}
}

docs {
  Metadata of enrollment codes people issued for this agent. Never the code itself.

  Scope: `org:read`.

  Errors: `invalid_cursor` (400), `unauthorized` (401), `ip_not_allowed` (403), `insufficient_scope` (403), `forbidden` (403), `not_found` (404), `feature_disabled` (404), `org_inactive` (409), `rate_limited` (429), `store_error` (500).
}

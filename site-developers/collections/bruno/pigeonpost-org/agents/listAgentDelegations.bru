meta {
  name: List an agent's delegations
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/agents/:agent/delegations
  body: none
  auth: bearer
}

params:path {
  agent: ci-bot
}

auth:bearer {
  token: {{token}}
}

docs {
  Who may operate the agent, with which capabilities. Delegation writes are human-only.

  Scope: `org:read`.

  Errors: `invalid_cursor` (400), `unauthorized` (401), `ip_not_allowed` (403), `insufficient_scope` (403), `forbidden` (403), `not_found` (404), `feature_disabled` (404), `org_inactive` (409), `rate_limited` (429), `store_error` (500).
}

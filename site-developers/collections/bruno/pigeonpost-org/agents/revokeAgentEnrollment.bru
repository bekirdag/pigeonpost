meta {
  name: Revoke an enrollment code
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/agents/:agent/enrollments/:enrollment
  body: none
  auth: bearer
}

params:path {
  agent: ci-bot
  enrollment: enr_ahv2rqphyz4bqgckiljwwiltn7
}

headers {
  ~Idempotency-Key: replace-with-a-unique-key
}

auth:bearer {
  token: {{token}}
}

docs {
  Revokes an unredeemed code, for example one that leaked from a CI log.

  Scope: `agents:write`.

  Errors: `unauthorized` (401), `ip_not_allowed` (403), `insufficient_scope` (403), `forbidden` (403), `not_found` (404), `feature_disabled` (404), `invite_used` (409), `org_inactive` (409), `org_read_only` (409), `idempotency_conflict` (409), `rate_limited` (429), `store_error` (500).
}

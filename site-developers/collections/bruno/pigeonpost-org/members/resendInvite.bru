meta {
  name: Resend an invitation
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/members/:member/resend-invite
  body: none
  auth: bearer
}

params:path {
  member: john
}

headers {
  ~Idempotency-Key: replace-with-a-unique-key
}

auth:bearer {
  token: {{token}}
}

docs {
  Issues a new invitation link for an invited member; the old link stops working. Returned once (`no-store`).

  Scope: `members:write`.

  Errors: `unauthorized` (401), `ip_not_allowed` (403), `insufficient_scope` (403), `forbidden` (403), `not_found` (404), `feature_disabled` (404), `invite_used` (409), `seat_limit` (409), `org_inactive` (409), `org_read_only` (409), `idempotency_conflict` (409), `rate_limited` (429), `store_error` (500).
}

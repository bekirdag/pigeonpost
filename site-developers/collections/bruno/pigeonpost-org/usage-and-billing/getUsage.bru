meta {
  name: Get usage
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/usage
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Seats, agents, rooms, storage used and call minutes over the last 30 days.

  Scope: `org:read`.

  Errors: `unauthorized` (401), `ip_not_allowed` (403), `insufficient_scope` (403), `forbidden` (403), `feature_disabled` (404), `org_inactive` (409), `rate_limited` (429), `store_error` (500).
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The OIDC round-trip comes back to this scheme. ASWebAuthenticationSession intercepts the
	     callback itself, but the scheme is registered so the redirect is also valid when the realm
	     hands it to the system — a Keycloak that ends the flow in Safari must still land here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.pigeonpost.inbox.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dev.pigeonpost.inbox</string>
			</array>
		</dict>
	</array>
	<!-- HTTPS and the platform's own TLS only. Declared so every upload is not held for an export
	     compliance question we already know the answer to. -->
	<!-- The camera: video calls (sent only to the people in the call, encrypted end to end), and
	     reading the sign-in QR that `pigeonpost login` prints on another machine. Nothing is
	     recorded or kept. -->
	<key>NSCameraUsageDescription</key>
	<string>For video calls, going live in your groups, taking a profile picture, and scanning the sign-in code shown by the pigeonpost command line.</string>
	<!-- Calls and live streams: audio goes to the people in the call or stream, encrypted end to end.
	     Meeting notes (only after everyone in the call agrees) encrypt the device's own microphone to
	     the notes service; see docs/apple-privacy-labels.md. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>So the people you call or stream to can hear you. Meeting notes use your own microphone only when everyone in the call has agreed.</string>
	<!-- Geist and Geist Mono (SIL OFL 1.1, Shared/Fonts/Geist-OFL.txt), the conversation design's type. -->
	<key>UIAppFonts</key>
	<array>
		<string>Geist-Regular.ttf</string>
		<string>Geist-Medium.ttf</string>
		<string>Geist-SemiBold.ttf</string>
		<string>Geist-Bold.ttf</string>
		<string>Geist-Italic.ttf</string>
		<string>GeistMono-Regular.ttf</string>
		<string>GeistMono-Medium.ttf</string>
		<string>GeistMono-SemiBold.ttf</string>
	</array>
	<!-- Incoming calls with the app closed (see Pigeonpost/Calls/CallAlerts.swift).
	     `voip`: PushKit wakes the app for a ring, which goes straight to the system call screen.
	     `audio`: a call's sound keeps running with the screen locked or another app in front, as a
	     phone call's does. Neither is used for anything but a call. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>

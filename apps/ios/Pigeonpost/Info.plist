<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The OIDC round-trip comes back to this scheme. ASWebAuthenticationSession intercepts the
	     callback itself, but the scheme is registered so the redirect is also valid when the realm
	     hands it to the system — a Keycloak that ends the flow in Safari must still land here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.pigeonpost.inbox.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dev.pigeonpost.inbox</string>
			</array>
		</dict>
	</array>
	<!-- HTTPS and the platform's own TLS only. Declared so every upload is not held for an export
	     compliance question we already know the answer to. -->
	<!-- The camera is used for exactly one thing: reading the sign-in QR that `pigeonpost login`
	     prints on another machine. Nothing is recorded, kept, or sent anywhere. -->
	<key>NSCameraUsageDescription</key>
	<string>To scan the sign-in code shown by the pigeonpost command line, so you can sign that machine in from here.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>

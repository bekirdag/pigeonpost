<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- `development` here; the archive that goes to TestFlight or the App Store is signed against a
	     distribution profile and carries `production` instead. The two APNs environments issue
	     different device tokens and neither accepts the other's, which is why the app tells the
	     postbox which one minted the token it is registering. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:inbox.pigeonpost.dev</string>
	</array>
	<!-- Sign in with Apple through the system sheet. The App ID is the primary one for the
	     `dev.pigeonpost.signin` Services ID the realm's web flow uses, so both give the same Apple
	     user id. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>

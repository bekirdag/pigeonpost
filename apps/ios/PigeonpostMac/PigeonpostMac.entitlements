<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed from the first build rather than retrofitted: what the app may reach is easier to
	     keep narrow than to make narrow later, and the App Store requires it. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The postbox and the realm. Nothing here listens. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Attachments: chosen by the person through the system picker, and written where they say. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Voice and video calls, and nothing else: the call runs in the app's web view, and the
	     microphone and camera are granted to the call page's own origin only (CallHost). Media goes
	     straight to the people in the call, encrypted end to end. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Remote notifications: mail notices, and a call ringing with the app closed (an Answer and
	     Decline banner; see MacCallAlerts). `development` here, as on the iPhone: the Mac App Store
	     archive is signed against the "Pigeonpost Desktop Mac App Store" profile, which carries
	     `production` (checked 2026-10-20 through the App Store Connect API: the App ID has
	     PUSH_NOTIFICATIONS and that profile lists com.apple.developer.aps-environment = production).
	     Mac App Store only: PigeonpostMac-DeveloperID.entitlements must not carry it. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple through the system sheet, as on the iPhone. Same App ID, so the same
	     Apple user id as the phone and the realm's web flow. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bundled IANA rules keep calendar authoring independent of Windows' historical registry data. Apache-2.0. -->
    <PackageReference Include="NodaTime" Version="3.3.6" />
    <!-- Sample data and the stand-in postbox are compiled only into the tests and the UI-test app. -->
    <Compile Remove="PreviewInboxService.cs" />
    <Compile Remove="Preview/**" />
    <ProjectReference Include="../Pigeonpost.GroupCrypto/Pigeonpost.GroupCrypto.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Pigeonpost.Desktop</RootNamespace>
    <AssemblyName>Pigeonpost</AssemblyName>
    <Version>1.0.10</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Pigeonpost.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- NotifyIcon needs the Forms runtime, but its desktop SDK imports the WPF
         XAML compiler, which conflicts with WinUI's own XAML build targets. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <ProjectReference Include="..\Pigeonpost.Core\Pigeonpost.Core.csproj" />
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Pigeonpost.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Geist and Geist Mono, SIL Open Font License 1.1; the license travels with the fonts. -->
    <Content Include="Assets\Fonts\Geist-Variable.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\GeistMono-Variable.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Notices\NodaTime.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Group end-to-end encryption: the Rust library for this architecture ships beside
       Pigeonpost.exe (and so inside the MSIX). build.ps1 builds it; a Release build without it
       fails rather than ship an app that would have to hide groups. -->
  <PropertyGroup>
    <GroupCryptoTriple Condition="'$(Platform)' == 'ARM64' or '$(RuntimeIdentifier)' == 'win-arm64'">aarch64-pc-windows-msvc</GroupCryptoTriple>
    <GroupCryptoTriple Condition="'$(GroupCryptoTriple)' == ''">x86_64-pc-windows-msvc</GroupCryptoTriple>
    <GroupCryptoNative>$(MSBuildThisFileDirectory)..\..\..\crates\pigeonpost-groupcrypto\target\$(GroupCryptoTriple)\release\pigeonpost_groupcrypto_ffi.dll</GroupCryptoNative>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(GroupCryptoNative)" Link="pigeonpost_groupcrypto_ffi.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(GroupCryptoNative)')" />
  </ItemGroup>
  <Target Name="RequireGroupCrypto" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' and !Exists('$(GroupCryptoNative)')">
    <Error Text="pigeonpost_groupcrypto_ffi.dll for $(GroupCryptoTriple) is missing ($(GroupCryptoNative)). Run build.ps1, which builds it." />
  </Target>
  <ItemGroup Condition="'$(DefineConstants)' == 'UI_TESTS'">
    <Compile Include="../Pigeonpost.Core/Preview/**/*.cs" LinkBase="Preview" />
    <Compile Include="../Pigeonpost.Core/PreviewInboxService.cs" Link="PreviewInboxService.cs" />
    <Content Include="../../../tests/fixtures/attachments/*" Link="PreviewFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ui-fixtures/*" Link="PreviewFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Window
    x:Class="Pigeonpost.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pigeonpost.Desktop"
    xmlns:core="using:Pigeonpost.Core"
    Title="Pigeonpost Desktop">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="Root_Loaded">
        <Grid.Resources>
            <DataTemplate x:Key="IncomingMessage" x:DataType="core:ThreadMessage">
                <Border HorizontalAlignment="Left" MaxWidth="640" Margin="12,5,64,5" Padding="16,12" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind DisplayBody}" Loaded="MessageBody_Loaded" Unloaded="MessageBody_Unloaded" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="14" />
                        <ItemsControl ItemsSource="{x:Bind Attachments}" IsEnabled="{x:Bind CanDownloadAttachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:MessageAttachment">
                                    <Button Tag="{x:Bind}" Click="SaveAttachment_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Margin="0,3" Padding="12,8" AutomationProperties.Name="{x:Bind DownloadLabel}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Filename}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind SizeLabel}" FontSize="12" />
                                            <TextBlock Text="Download file" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind TimeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <Border.ContextFlyout>
                        <MenuFlyout><MenuFlyoutItem Text="Copy original message" Tag="{x:Bind Body}" Click="CopyOriginal_Click" /><MenuFlyoutItem Text="Save attachments…" Tag="{x:Bind}" Click="SaveFiles_Click" /></MenuFlyout>
                    </Border.ContextFlyout>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="OutgoingMessage" x:DataType="core:ThreadMessage">
                <Border HorizontalAlignment="Right" MaxWidth="640" Margin="64,5,12,5" Padding="16,12" CornerRadius="12"
                        Background="{ThemeResource OutgoingMessageBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind DisplayBody}" Loaded="MessageBody_Loaded" Unloaded="MessageBody_Unloaded" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="14" />
                        <ItemsControl ItemsSource="{x:Bind Attachments}" IsEnabled="{x:Bind CanDownloadAttachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:MessageAttachment">
                                    <Button Tag="{x:Bind}" Click="SaveAttachment_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Margin="0,3" Padding="12,8" AutomationProperties.Name="{x:Bind DownloadLabel}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Filename}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind SizeLabel}" FontSize="12" />
                                            <TextBlock Text="Download file" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind TimeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <Border.ContextFlyout>
                        <MenuFlyout><MenuFlyoutItem Text="Copy original message" Tag="{x:Bind Body}" Click="CopyOriginal_Click" /><MenuFlyoutItem Text="Save attachments…" Tag="{x:Bind}" Click="SaveFiles_Click" /></MenuFlyout>
                    </Border.ContextFlyout>
                </Border>
            </DataTemplate>
            <local:MessageTemplateSelector x:Key="MessageTemplateSelector"
                Incoming="{StaticResource IncomingMessage}" Outgoing="{StaticResource OutgoingMessage}" />
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewConversation_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SenderSearch_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Refresh_Invoked" />
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="Send_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <InfoBar Grid.Row="0" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
                 Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        <Grid x:Name="InboxLayout" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SenderColumn" Width="300" MinWidth="240" MaxWidth="420" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="SubjectColumn" Width="210" MinWidth="170" MaxWidth="340" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Padding="12,16,12,12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="ms-appx:///Assets/Logo.png" Width="30" Height="30" AutomationProperties.Name="Pigeonpost" />
                    <TextBlock Text="Pigeonpost" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <ComboBox Grid.Row="1" ItemsSource="{x:Bind ViewModel.Mailboxes, Mode=OneWay}" DisplayMemberPath="DisplayName"
                          SelectedItem="{x:Bind ViewModel.SelectedMailbox, Mode=OneWay}" SelectionChanged="Mailbox_SelectionChanged"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Mailbox" />
                <TextBox x:Name="SenderSearchBox" Grid.Row="2" PlaceholderText="Search senders"
                         Text="{x:Bind ViewModel.SenderSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search senders" />
                <Grid Grid.Row="3">
                    <ListView ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=OneWay}"
                              SelectionChanged="Conversation_SelectionChanged" SelectionMode="Single" AutomationProperties.Name="Conversations">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Conversation">
                                <StackPanel Padding="2,8" Spacing="3">
                                    <StackPanel.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copy address" Tag="{x:Bind Peer}" Click="CopyPeer_Click" /></MenuFlyout></StackPanel.ContextFlyout>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Peer}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Preview}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Badge}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ViewModel.EmptyListMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="12,20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"
                               Visibility="{x:Bind ToVisibility(ViewModel.IsListEmpty), Mode=OneWay}" />
                </Grid>
                <StackPanel Grid.Row="4" Spacing="10">
                    <Button Content="New conversation" Click="NewConversation_Click" HorizontalAlignment="Stretch" AutomationProperties.HelpText="Control N" />
                    <ToggleSwitch Header="Archived conversations" IsOn="{x:Bind ViewModel.ShowArchived, Mode=TwoWay}" OnContent="Showing archive" OffContent="Showing inbox" />
                    <TextBlock Text="{x:Bind ViewModel.InboxSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <Thumb Grid.Column="1" DragDelta="SenderColumn_DragDelta" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Resize conversations column" />
            <Grid Grid.Column="2" Padding="12,18,12,12" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Subjects" FontSize="18" FontWeight="SemiBold" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Subjects, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=OneWay}"
                          SelectionChanged="Subject_SelectionChanged" SelectionMode="Single" AutomationProperties.Name="Subjects">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:Subject">
                            <StackPanel Padding="2,8" Spacing="5">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Spacing="6">
                    <Button Content="New subject" Click="NewSubject_Click" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                    <Button Content="Delete subject…" Click="DeleteSubject_Click" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanDeleteSubject, Mode=OneWay}" />
                </StackPanel>
            </Grid>
            <Thumb Grid.Column="3" DragDelta="SubjectColumn_DragDelta" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Resize subjects column" />
            <Grid x:Name="MessagingArea" Grid.Column="4" Background="Transparent" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Padding="18,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <HyperlinkButton Content="{x:Bind ViewModel.ConversationTitle, Mode=OneWay}" Click="Contact_Click" Padding="0" FontSize="20" FontWeight="SemiBold"
                                         HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Sender details" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <HyperlinkButton Click="Contact_Click" Padding="0" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                             IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Sender address details">
                                <TextBlock Text="{x:Bind ViewModel.ConversationAddress, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </HyperlinkButton>
                            <HyperlinkButton Grid.Column="1" Content="Copy address" Click="CopyPeer_Click" Padding="0" FontSize="12" IsEnabled="{x:Bind ViewModel.HasConversation, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.SubjectTitle, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="More" VerticalAlignment="Top" AutomationProperties.Name="Conversation actions">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.ArchiveAction, Mode=OneWay}" Click="Archive_Click" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                                <MenuFlyoutItem Text="Refresh" Click="Refresh_Click" />
                                <MenuFlyoutItem Text="Sender details" Click="Contact_Click" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="18,0,18,10" ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox" PlaceholderText="Find in this subject" Text="{x:Bind ViewModel.Find, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find in this subject" />
                    <Button Grid.Column="1" Content="↑" Click="PreviousMatch_Click" AutomationProperties.Name="Previous match" />
                    <Button Grid.Column="2" Content="↓" Click="NextMatch_Click" AutomationProperties.Name="Next match" />
                </Grid>
                <Grid Grid.Row="2">
                    <ListView x:Name="MessageList" ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}" SelectionMode="Single"
                              ItemTemplateSelector="{StaticResource MessageTemplateSelector}" AutomationProperties.Name="Messages"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" /></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" IsHitTestVisible="False" />
                </Grid>
                <StackPanel Grid.Row="3" Padding="18,10,18,14" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.FindSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer MaxHeight="128" Visibility="{x:Bind ToVisibility(ViewModel.HasDraftAttachments), Mode=OneWay}" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DraftAttachments, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Attached files">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:DraftAttachment">
                                    <Grid ColumnSpacing="8" Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Filename}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="Remove" Tag="{x:Bind}" Click="RemoveAttachment_Click" AutomationProperties.Name="{x:Bind RemoveLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox x:Name="Composer" Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Write a message…"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" MaxLength="20000"
                             IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Message" />
                    <Grid>
                        <Button Content="Attach files…" Click="Attach_Click" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                        <Button Content="Send" Click="Send_Click" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel x:Name="Welcome" Grid.RowSpan="3" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Margin="32">
            <Image Source="ms-appx:///Assets/Logo.png" Width="80" Height="80" AutomationProperties.Name="Pigeonpost" />
            <TextBlock Text="Your agents, in one place" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Conversations with your people and agents, organized by mailbox and subject." TextWrapping="Wrap" TextAlignment="Center" FontSize="16" />
            <TextBlock x:Name="AuthStatus" Text="Sign in or create a free Pigeonpost account in your browser." TextWrapping="Wrap" TextAlignment="Center" IsTextSelectionEnabled="True" />
            <ProgressRing x:Name="SignInProgress" IsActive="False" Width="28" Height="28" />
            <StackPanel x:Name="CodePanel" Visibility="Collapsed" Spacing="12">
                <TextBlock x:Name="CodeLabel" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" IsTextSelectionEnabled="True" AutomationProperties.Name="Sign-in code" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button Content="Copy code" Click="CopyCode_Click" />
                    <Button Content="Open browser" Click="OpenSignIn_Click" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="SignInButton" Content="Sign in or create account" Click="SignIn_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="CancelSignIn" Content="Cancel sign-in" Click="CancelSignIn_Click" HorizontalAlignment="Center" Visibility="Collapsed" />
            <HyperlinkButton Content="Privacy policy" Click="Privacy_Click" HorizontalAlignment="Center" />
        </StackPanel>
        <Border x:Name="EmptyAccount" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32">
            <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="Connect your first mailbox" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Create a free mailbox to start conversations with your people and agents. Already have a mailbox? Refresh to load it." TextWrapping="Wrap" />
                <Button Content="Create free mailbox" Click="CreateMailbox_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Refresh mailboxes" Click="ReloadAccount_Click" />
            </StackPanel>
        </Border>
        <Border x:Name="AccountBar" Grid.Row="2" Visibility="Collapsed" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind BuildLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AccountStatus" Text="Connected to Pigeonpost" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Copy my address" Click="CopyAddress_Click" />
                <Button Grid.Column="2" Content="Manage account" Click="ManageAccount_Click" />
                <Button Grid.Column="3" Content="Sign out" Click="SignOut_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>

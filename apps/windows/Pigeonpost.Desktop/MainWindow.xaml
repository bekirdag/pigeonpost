<Window
    x:Class="Pigeonpost.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pigeonpost.Desktop"
    xmlns:core="using:Pigeonpost.Core"
    Title="Pigeonpost Desktop">
    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <local:BooleanVisibilityConverter x:Key="BoolVisibility" />
            <local:TextVisibilityConverter x:Key="TextVisibility" />
            <!-- Plain TextBlocks are not Controls; give them the design's typeface explicitly. -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            </Style>
            <Style x:Key="QuietIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" /><Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8" /><Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="ToolbarIconButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource IconButtonSurfaceBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource IconButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="9" /><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="FooterIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" /><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="SecondaryActionButton" TargetType="Button">
                <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="16,0" /><Setter Property="CornerRadius" Value="9" />
                <Setter Property="FontSize" Value="13.5" /><Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="16,0" /><Setter Property="CornerRadius" Value="9" />
                <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SidebarComboBox" TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="9" /><Setter Property="MinHeight" Value="36" /><Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="AttachmentButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AttachmentSurfaceBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource AttachmentBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
                <Setter Property="FontSize" Value="11.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            </Style>
            <Style x:Key="PaneDivider" TargetType="Thumb">
                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                    <Border Background="{ThemeResource NavigationSurfaceBrush}"><Border Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerBrush}" /></Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <DataTemplate x:Key="IncomingMessage" x:DataType="core:ThreadMessage">
                <Border HorizontalAlignment="Left" MaxWidth="620" Margin="24,7,64,7" CornerRadius="14"
                        Background="{ThemeResource IncomingMessageBrush}" BorderBrush="{ThemeResource IncomingBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Padding="16,12,16,14" Spacing="10" PointerPressed="MessageBody_Pointer" PointerReleased="MessageBody_Pointer" Tapped="MessageBody_Tapped" DoubleTapped="MessageBody_DoubleTapped">
                            <TextBlock Text="{x:Bind DisplayBody}" Loaded="MessageBody_Loaded" Unloaded="MessageBody_Unloaded" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       ContextRequested="MessageBody_ContextRequested"
                                       FontSize="14.5" LineHeight="21" Foreground="{ThemeResource IncomingTextBrush}" />
                            <ItemsControl ItemsSource="{x:Bind Attachments}" IsEnabled="{x:Bind CanDownloadAttachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:MessageAttachment">
                                        <Button Tag="{x:Bind}" Click="SaveAttachment_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource AttachmentButton}"
                                                Margin="0,3" Padding="12,10" AutomationProperties.Name="{x:Bind DownloadLabel}">
                                            <StackPanel Spacing="4">
                                                <Border Tag="{x:Bind}" Width="220" Height="150" CornerRadius="8" Loaded="AttachmentPreview_Loaded" Unloaded="AttachmentPreview_Unloaded" />
                                                <TextBlock Text="{x:Bind Filename}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind SizeLabel}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                                <TextBlock Text="Download file" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource IncomingFooterBorderBrush}" Padding="16,6,12,6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind TimeLabel}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource IncomingFooterTextBrush}" />
                                <Border Grid.Column="1" Padding="8,2,8,3" CornerRadius="6" VerticalAlignment="Center" Background="{ThemeResource ChipSurfaceBrush}"
                                        Visibility="{Binding StatusLabel, Converter={StaticResource TextVisibility}}">
                                    <TextBlock Text="{x:Bind StatusLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource ChipTextBrush}" />
                                </Border>
                                <Button Grid.Column="3" Tag="{x:Bind CopyText}" Click="CopyMessage_Click" Style="{StaticResource FooterIconButton}" Foreground="{ThemeResource IncomingFooterTextBrush}"
                                        AutomationProperties.Name="Copy message" AutomationProperties.AutomationId="{x:Bind Id}" ToolTipService.ToolTip="Copy message">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Border.ContextFlyout>
                        <MenuFlyout><MenuFlyoutItem Text="Copy original message" Tag="{x:Bind Body}" Click="CopyOriginal_Click" /><MenuFlyoutItem Text="Save attachments…" Tag="{x:Bind}" Click="SaveFiles_Click" /></MenuFlyout>
                    </Border.ContextFlyout>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="OutgoingMessage" x:DataType="core:ThreadMessage">
                <Border HorizontalAlignment="Right" MaxWidth="620" Margin="64,7,24,7" CornerRadius="14"
                        Background="{ThemeResource OutgoingMessageBrush}" BorderBrush="{ThemeResource OutgoingBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Padding="16,12,16,14" Spacing="10" PointerPressed="MessageBody_Pointer" PointerReleased="MessageBody_Pointer" Tapped="MessageBody_Tapped" DoubleTapped="MessageBody_DoubleTapped">
                            <TextBlock Text="{x:Bind DisplayBody}" Loaded="MessageBody_Loaded" Unloaded="MessageBody_Unloaded" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       ContextRequested="MessageBody_ContextRequested"
                                       FontSize="14.5" LineHeight="21" Foreground="{ThemeResource OutgoingTextBrush}" />
                            <ItemsControl ItemsSource="{x:Bind Attachments}" IsEnabled="{x:Bind CanDownloadAttachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:MessageAttachment">
                                        <Button Tag="{x:Bind}" Click="SaveAttachment_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource AttachmentButton}"
                                                Margin="0,3" Padding="12,10" AutomationProperties.Name="{x:Bind DownloadLabel}">
                                            <StackPanel Spacing="4">
                                                <Border Tag="{x:Bind}" Width="220" Height="150" CornerRadius="8" Loaded="AttachmentPreview_Loaded" Unloaded="AttachmentPreview_Unloaded" />
                                                <TextBlock Text="{x:Bind Filename}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind SizeLabel}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                                <TextBlock Text="Download file" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutgoingFooterBorderBrush}" Padding="16,6,12,6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind TimeLabel}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource OutgoingFooterTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind StatusLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource OutgoingFooterTextBrush}" />
                                <Button Grid.Column="3" Tag="{x:Bind CopyText}" Click="CopyMessage_Click" Style="{StaticResource FooterIconButton}" Foreground="{ThemeResource OutgoingFooterTextBrush}"
                                        AutomationProperties.Name="Copy message" AutomationProperties.AutomationId="{x:Bind Id}" ToolTipService.ToolTip="Copy message">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Border.ContextFlyout>
                        <MenuFlyout><MenuFlyoutItem Text="Copy original message" Tag="{x:Bind Body}" Click="CopyOriginal_Click" /><MenuFlyoutItem Text="Save attachments…" Tag="{x:Bind}" Click="SaveFiles_Click" /></MenuFlyout>
                    </Border.ContextFlyout>
                </Border>
            </DataTemplate>
            <local:MessageTemplateSelector x:Key="MessageTemplateSelector"
                Incoming="{StaticResource IncomingMessage}" Outgoing="{StaticResource OutgoingMessage}" />
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewConversation_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SenderSearch_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Refresh_Invoked" />
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="Send_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <InfoBar Grid.Row="0" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
                 Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        <Grid x:Name="InboxLayout" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SenderColumn" Width="304" />
                <ColumnDefinition x:Name="SenderDividerColumn" Width="5" />
                <ColumnDefinition x:Name="SubjectColumn" Width="0" />
                <ColumnDefinition x:Name="SubjectDividerColumn" Width="0" />
                <ColumnDefinition x:Name="MessageColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="SenderPane" Padding="12,16,12,8" RowSpacing="12" Background="{ThemeResource NavigationSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10" Padding="6,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/Logo.png" Width="26" Height="26" AutomationProperties.Name="Pigeonpost" />
                    <TextBlock Grid.Column="1" Text="Pigeonpost" FontSize="15" FontWeight="SemiBold" CharacterSpacing="-10" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <Button Grid.Column="2" Click="NewConversation_Click" Style="{StaticResource QuietIconButton}" Width="34" Height="34" Padding="0" AutomationProperties.Name="New conversation" ToolTipService.ToolTip="New conversation (Ctrl+N)">
                        <FontIcon Glyph="&#xE8F2;" FontSize="16" />
                    </Button>
                </Grid>
                <ComboBox Grid.Row="1" ItemsSource="{x:Bind ViewModel.Mailboxes, Mode=OneWay}" DisplayMemberPath="DisplayName"
                          SelectedItem="{x:Bind ViewModel.SelectedMailbox, Mode=OneWay}" SelectionChanged="Mailbox_SelectionChanged"
                          Style="{StaticResource SidebarComboBox}" MinHeight="44" CornerRadius="10" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Mailbox" ToolTipService.ToolTip="Choose the mailbox you send from" />
                <TextBox x:Name="SenderSearchBox" Grid.Row="2" PlaceholderText="Search conversations" FontSize="13.5"
                         Text="{x:Bind ViewModel.SenderSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search senders" />
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ComboBox SelectedIndex="0" SelectionChanged="ArchiveFilter_SelectionChanged" Style="{StaticResource SidebarComboBox}" AutomationProperties.Name="Conversation filter" MinWidth="108">
                        <ComboBoxItem Content="Inbox" /><ComboBoxItem Content="Archived" />
                    </ComboBox>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.InboxSummary, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextTertiaryBrush}" />
                </Grid>
                <Grid Grid.Row="4" Margin="-4,0,-4,0">
                    <ListView x:Name="ConversationList" ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=OneWay}"
                              SelectionChanged="Conversation_SelectionChanged" IsItemClickEnabled="True" ItemClick="Conversation_ItemClick"
                              SelectionMode="Single" AutomationProperties.Name="Conversations" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="10,10" /><Setter Property="Margin" Value="4,1" /></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Conversation">
                                <Grid ColumnSpacing="11" AutomationProperties.Name="{x:Bind AccessibleSummary}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copy address" Tag="{x:Bind Peer}" Click="CopyPeer_Click" /></MenuFlyout></Grid.ContextFlyout>
                                    <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top" Background="{ThemeResource AvatarSurfaceBrush}">
                                        <TextBlock Text="{x:Bind Initials}" FontSize="12" FontWeight="Bold" CharacterSpacing="20" Foreground="{ThemeResource AvatarTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextPrimaryBrush}" ToolTipService.ToolTip="{x:Bind Peer}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ActivityLabel}" FontSize="11.5" VerticalAlignment="Center" Foreground="{ThemeResource TextTertiaryBrush}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Preview}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <Border Grid.Column="1" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" VerticalAlignment="Center" Background="{ThemeResource AccentBrush}" Visibility="{Binding HasUnread, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="{x:Bind UnreadLabel}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource OnAccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <Border Height="18" Padding="6,0" Margin="0,2,0,0" CornerRadius="5" HorizontalAlignment="Left" Background="{ThemeResource ReviewSurfaceBrush}" Visibility="{Binding HasHeld, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="{x:Bind ReviewLabel}" FontSize="10.5" FontWeight="SemiBold" CharacterSpacing="40" VerticalAlignment="Center" Foreground="{ThemeResource ReviewTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ViewModel.EmptyListMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="16,24" FontSize="13"
                               Foreground="{ThemeResource TextSecondaryBrush}" IsHitTestVisible="False"
                               Visibility="{x:Bind ToVisibility(ViewModel.IsListEmpty), Mode=OneWay}" />
                </Grid>
            </Grid>
            <Thumb x:Name="SenderDivider" Grid.Column="1" DragDelta="SenderColumn_DragDelta" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize conversations column" />
            <Grid x:Name="SubjectPane" Grid.Column="2" Padding="8,22,8,12" RowSpacing="10" Visibility="Collapsed" Background="{ThemeResource ThreadsSurfaceBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Subjects" Style="{StaticResource SectionLabel}" Margin="10,0,0,0" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Subjects, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=OneWay}"
                          SelectionChanged="Subject_SelectionChanged" SelectionMode="Single" AutomationProperties.Name="Subjects">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="10,9" /><Setter Property="Margin" Value="0,1" /></Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:Subject">
                            <StackPanel Spacing="3" AutomationProperties.Name="{x:Bind AccessibleSummary}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontSize="13.5" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <Border Grid.Column="1" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" VerticalAlignment="Top" Background="{ThemeResource AccentBrush}" Visibility="{Binding HasUnread, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="{x:Bind UnreadLabel}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource OnAccentBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Grid.Row="2" Content="New subject" Click="NewSubject_Click" Style="{StaticResource SecondaryActionButton}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
            </Grid>
            <Thumb x:Name="SubjectDivider" Grid.Column="3" DragDelta="SubjectColumn_DragDelta" Style="{StaticResource PaneDivider}" Visibility="Collapsed" AutomationProperties.Name="Resize subjects column" />
            <Grid x:Name="MessagingArea" Grid.Column="4" Background="{ThemeResource ConversationSurfaceBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,12,20,12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource QuietIconButton}" Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.Name="Back to conversations" ToolTipService.ToolTip="Back to conversations"><SymbolIcon Symbol="Back" /></Button>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <HyperlinkButton Click="Contact_Click" Padding="0" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{ThemeResource TextPrimaryBrush}"
                                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Sender details">
                                    <TextBlock Text="{x:Bind ViewModel.ConversationTitle, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" CharacterSpacing="-10" TextTrimming="CharacterEllipsis" />
                                </HyperlinkButton>
                                <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <HyperlinkButton Click="Contact_Click" Padding="0" FontSize="12.5" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalContentAlignment="Left"
                                                     IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Sender address details">
                                        <TextBlock Text="{x:Bind ViewModel.ConversationAddress, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                    <Button Grid.Column="1" Click="CopyPeer_Click" Style="{StaticResource FooterIconButton}" Width="24" Height="24" Foreground="{ThemeResource TextTertiaryBrush}" IsEnabled="{x:Bind ViewModel.HasConversation, Mode=OneWay}" AutomationProperties.Name="Copy address" ToolTipService.ToolTip="Copy address"><FontIcon Glyph="&#xE8C8;" FontSize="12" /></Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="FindButton" Click="Find_Click" Style="{StaticResource ToolbarIconButton}" IsEnabled="{x:Bind ViewModel.HasConversation, Mode=OneWay}" AutomationProperties.Name="Find messages" ToolTipService.ToolTip="Find in this subject (Ctrl+F)"><FontIcon Glyph="&#xE721;" FontSize="14" /></Button>
                                <Button Style="{StaticResource ToolbarIconButton}" AutomationProperties.Name="Conversation actions" ToolTipService.ToolTip="Conversation actions">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout><MenuFlyout>
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ArchiveAction, Mode=OneWay}" Click="Archive_Click" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Refresh" Click="Refresh_Click" />
                                        <MenuFlyoutItem Text="Sender details" Click="Contact_Click" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                                    </MenuFlyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SubjectSelector" ItemsSource="{x:Bind ViewModel.Subjects, Mode=OneWay}" DisplayMemberPath="PickerLabel"
                                      SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=OneWay}" SelectionChanged="Subject_SelectionChanged" Style="{StaticResource SidebarComboBox}" MinHeight="32" CornerRadius="8"
                                      IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" HorizontalAlignment="Left" MinWidth="132" MaxWidth="320" AutomationProperties.Name="Current subject" ToolTipService.ToolTip="Switch subject" />
                            <Button Grid.Column="1" Style="{StaticResource QuietIconButton}" AutomationProperties.Name="Subject actions" ToolTipService.ToolTip="Subject actions" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <Button.Flyout><MenuFlyout>
                                    <MenuFlyoutItem Text="New subject" Click="NewSubject_Click" />
                                    <MenuFlyoutItem Text="Delete subject…" Click="DeleteSubject_Click" IsEnabled="{x:Bind ViewModel.CanDeleteSubject, Mode=OneWay}" />
                                </MenuFlyout></Button.Flyout>
                            </Button>
                            <ToggleButton x:Name="PinSubjectsButton" Grid.Column="2" IsChecked="True" Checked="PinSubjects_Click" Unchecked="PinSubjects_Click" Padding="8" MinWidth="32" MinHeight="32" CornerRadius="8" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextSecondaryBrush}" AutomationProperties.Name="Pin subjects" ToolTipService.ToolTip="Show or hide the subjects column">
                                <ToggleButton.Resources>
                                    <!-- Checked states animate from template storyboards, so the quiet pinned look is scoped here. -->
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#E4E9F1" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#DCE2EC" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D3DAE6" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#15181D" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#15181D" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#15181D" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Default">
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#252B34" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2B323C" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#313844" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E8EAED" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E8EAED" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E8EAED" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </ToggleButton.Resources>
                                <FontIcon Glyph="&#xE840;" FontSize="16" />
                            </ToggleButton>
                        </Grid>
                    </Grid>
                </Border>
                <Grid x:Name="FindBar" Grid.Row="1" Margin="24,12,20,0" ColumnSpacing="6" RowSpacing="4" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox" PlaceholderText="Find in this subject" FontSize="13.5" Text="{x:Bind ViewModel.Find, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find in this subject" KeyDown="FindBox_KeyDown" />
                    <Button Grid.Column="1" Content="↑" Click="PreviousMatch_Click" MinWidth="36" MinHeight="36" CornerRadius="9" AutomationProperties.Name="Previous match" />
                    <Button Grid.Column="2" Content="↓" Click="NextMatch_Click" MinWidth="36" MinHeight="36" CornerRadius="9" AutomationProperties.Name="Next match" />
                    <Button Grid.Column="3" Click="CloseFind_Click" Style="{StaticResource QuietIconButton}" AutomationProperties.Name="Close search" ToolTipService.ToolTip="Close search (Esc)"><SymbolIcon Symbol="Cancel" /></Button>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{x:Bind ViewModel.FindSummary, Mode=OneWay}" FontSize="12" Margin="2,0,0,0" Foreground="{ThemeResource TextTertiaryBrush}" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,10">
                    <ListView x:Name="MessageList" ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}" SelectionMode="Single"
                              ItemTemplateSelector="{StaticResource MessageTemplateSelector}" AutomationProperties.Name="Messages"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </ListView.Resources>
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" /></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="AllowDrop" Value="True" /></Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" IsHitTestVisible="False" />
                </Grid>
                <Border Grid.Row="3" Padding="24,12,24,18" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerBrush}" Background="{ThemeResource ComposerAreaBrush}">
                <Border Padding="10,8,12,12" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource ComposerBorderBrush}" Background="{ThemeResource ComposerSurfaceBrush}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer MaxHeight="120" Visibility="{x:Bind ToVisibility(ViewModel.HasDraftAttachments), Mode=OneWay}" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DraftAttachments, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Attached files">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:DraftAttachment">
                                        <Border CornerRadius="10" Background="{ThemeResource AttachmentSurfaceBrush}" BorderBrush="{ThemeResource AttachmentBorderBrush}" BorderThickness="1" Padding="8" Margin="2,2,2,4">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Tag="{x:Bind}" Width="48" Height="40" CornerRadius="6" Loaded="AttachmentPreview_Loaded" Unloaded="AttachmentPreview_Unloaded" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Filename}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" FontSize="12.5" ToolTipService.ToolTip="{x:Bind Filename}" />
                                                <Button Grid.Column="2" Tag="{x:Bind}" Click="RemoveAttachment_Click" Style="{StaticResource QuietIconButton}" AutomationProperties.Name="{x:Bind RemoveLabel}" ToolTipService.ToolTip="Remove attachment"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBox x:Name="Composer" Grid.Row="1" Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Write a message…"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="144" MaxLength="20000" BorderThickness="0" Background="Transparent" FontSize="14.5" Padding="6,6,6,4"
                                 IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Message" Paste="Composer_Paste">
                            <TextBox.Resources>
                                <!-- The card is the field: keep the inner editor flat in every state. -->
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                            </TextBox.Resources>
                            <TextBox.KeyboardAccelerators>
                                <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAttachment_Invoked" />
                                <KeyboardAccelerator Key="Insert" Modifiers="Shift" Invoked="PasteAttachment_Invoked" />
                            </TextBox.KeyboardAccelerators>
                        </TextBox>
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button Click="Attach_Click" Style="{StaticResource QuietIconButton}" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Attach files…" ToolTipService.ToolTip="Attach files or paste from clipboard"><SymbolIcon Symbol="Attach" /></Button>
                            <TextBlock Grid.Column="1" Text="Ctrl+Enter to send" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextTertiaryBrush}" />
                            <Button Grid.Column="2" Content="Send" Click="Send_Click" Style="{StaticResource PrimaryActionButton}" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>
                </Border>
            </Grid>
        </Grid>
        <StackPanel x:Name="Welcome" Grid.RowSpan="3" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Margin="32">
            <Image Source="ms-appx:///Assets/Logo.png" Width="80" Height="80" AutomationProperties.Name="Pigeonpost" />
            <TextBlock Text="Your agents, in one place" FontSize="30" FontWeight="SemiBold" CharacterSpacing="-20" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Text="Conversations with your people and agents, organized by mailbox and subject." TextWrapping="Wrap" TextAlignment="Center" FontSize="15" LineHeight="22" Foreground="{ThemeResource TextSecondaryBrush}" />
            <TextBlock x:Name="AuthStatus" Text="Sign in or create a free Pigeonpost account in your browser." TextWrapping="Wrap" TextAlignment="Center" FontSize="13.5" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextSecondaryBrush}" />
            <ProgressRing x:Name="SignInProgress" IsActive="False" Width="28" Height="28" />
            <StackPanel x:Name="CodePanel" Visibility="Collapsed" Spacing="12">
                <TextBlock x:Name="CodeLabel" FontSize="28" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" TextAlignment="Center" IsTextSelectionEnabled="True" AutomationProperties.Name="Sign-in code" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button Content="Copy code" Click="CopyCode_Click" Style="{StaticResource SecondaryActionButton}" />
                    <Button Content="Open browser" Click="OpenSignIn_Click" Style="{StaticResource SecondaryActionButton}" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="SignInButton" Content="Sign in or create account" Click="SignIn_Click" HorizontalAlignment="Center" Style="{StaticResource PrimaryActionButton}" MinHeight="38" Padding="18,0" FontSize="13.5" />
            <Button x:Name="CancelSignIn" Content="Cancel sign-in" Click="CancelSignIn_Click" HorizontalAlignment="Center" Visibility="Collapsed" Style="{StaticResource SecondaryActionButton}" />
            <HyperlinkButton Content="Privacy policy" Click="Privacy_Click" HorizontalAlignment="Center" FontSize="13" Foreground="{ThemeResource AccentBrush}" />
        </StackPanel>
        <Border x:Name="EmptyAccount" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource AppBackgroundBrush}" Padding="32">
            <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="Connect your first mailbox" FontSize="26" FontWeight="SemiBold" CharacterSpacing="-20" TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="Create a free mailbox to start conversations with your people and agents. Already have a mailbox? Refresh to load it." TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{ThemeResource TextSecondaryBrush}" />
                <Button Content="Create free mailbox" Click="CreateMailbox_Click" Style="{StaticResource PrimaryActionButton}" MinHeight="38" />
                <Button Content="Refresh mailboxes" Click="ReloadAccount_Click" Style="{StaticResource SecondaryActionButton}" MinHeight="38" />
            </StackPanel>
        </Border>
        <Border x:Name="AccountBar" Grid.Row="2" Visibility="Collapsed" Background="{ThemeResource NavigationSurfaceBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,6,16,6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource QuietIconButton}" Padding="6" AutomationProperties.Name="Account" ToolTipService.ToolTip="Account and settings">
                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                    <Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="Copy my address" Click="CopyAddress_Click" />
                        <MenuFlyoutItem Text="Manage account" Click="ManageAccount_Click" />
                        <MenuFlyoutItem Text="Privacy policy" Click="Privacy_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="{x:Bind BuildLabel}" IsEnabled="False" />
                        <MenuFlyoutItem Text="Sign out" Click="SignOut_Click" />
                    </MenuFlyout></Button.Flyout>
                </Button>
                <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SendingAsLabel" Text="Sending as" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MailboxAddress, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.MailboxAddress, Mode=OneWay}" />
                </Grid>
                <TextBlock x:Name="AccountStatus" Grid.Column="2" Text="Connected" MaxWidth="220" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>

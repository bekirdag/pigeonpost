<Window
    x:Class="Pigeonpost.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pigeonpost.Desktop"
    xmlns:core="using:Pigeonpost.Core"
    Title="Pigeonpost Desktop">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <local:BooleanVisibilityConverter x:Key="BoolVisibility" />
            <Style x:Key="QuietIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" /><Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="PaneDivider" TargetType="Thumb">
                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                    <Border Background="{ThemeResource NavigationSurfaceBrush}"><Border Width="1" HorizontalAlignment="Center" Background="{ThemeResource CardStrokeColorDefaultBrush}" /></Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <DataTemplate x:Key="IncomingMessage" x:DataType="core:ThreadMessage">
                <Border HorizontalAlignment="Left" MaxWidth="640" Margin="16,6,40,6" Padding="16,12" CornerRadius="12"
                        Background="{ThemeResource IncomingMessageBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind DisplayBody}" Loaded="MessageBody_Loaded" Unloaded="MessageBody_Unloaded" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="15" />
                        <ItemsControl ItemsSource="{x:Bind Attachments}" IsEnabled="{x:Bind CanDownloadAttachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:MessageAttachment">
                                    <Button Tag="{x:Bind}" Click="SaveAttachment_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Margin="0,3" Padding="12,8" AutomationProperties.Name="{x:Bind DownloadLabel}">
                                        <StackPanel Spacing="4">
                                            <Border Tag="{x:Bind}" Width="220" Height="150" CornerRadius="8" Loaded="AttachmentPreview_Loaded" Unloaded="AttachmentPreview_Unloaded" />
                                            <TextBlock Text="{x:Bind Filename}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind SizeLabel}" FontSize="12" />
                                            <TextBlock Text="Download file" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind TimeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                            <Button Tag="{x:Bind CopyText}" Click="CopyMessage_Click" Padding="4" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="Copy message" AutomationProperties.AutomationId="{x:Bind Id}" ToolTipService.ToolTip="Copy message">
                                <SymbolIcon Symbol="Copy" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Border.ContextFlyout>
                        <MenuFlyout><MenuFlyoutItem Text="Copy original message" Tag="{x:Bind Body}" Click="CopyOriginal_Click" /><MenuFlyoutItem Text="Save attachments…" Tag="{x:Bind}" Click="SaveFiles_Click" /></MenuFlyout>
                    </Border.ContextFlyout>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="OutgoingMessage" x:DataType="core:ThreadMessage">
                <Border HorizontalAlignment="Right" MaxWidth="640" Margin="40,6,16,6" Padding="16,12" CornerRadius="12"
                        Background="{ThemeResource OutgoingMessageBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind DisplayBody}" Loaded="MessageBody_Loaded" Unloaded="MessageBody_Unloaded" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="15" />
                        <ItemsControl ItemsSource="{x:Bind Attachments}" IsEnabled="{x:Bind CanDownloadAttachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:MessageAttachment">
                                    <Button Tag="{x:Bind}" Click="SaveAttachment_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Margin="0,3" Padding="12,8" AutomationProperties.Name="{x:Bind DownloadLabel}">
                                        <StackPanel Spacing="4">
                                            <Border Tag="{x:Bind}" Width="220" Height="150" CornerRadius="8" Loaded="AttachmentPreview_Loaded" Unloaded="AttachmentPreview_Unloaded" />
                                            <TextBlock Text="{x:Bind Filename}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind SizeLabel}" FontSize="12" />
                                            <TextBlock Text="Download file" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind TimeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" />
                            <Button Tag="{x:Bind CopyText}" Click="CopyMessage_Click" Padding="4" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="Copy message" AutomationProperties.AutomationId="{x:Bind Id}" ToolTipService.ToolTip="Copy message">
                                <SymbolIcon Symbol="Copy" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Border.ContextFlyout>
                        <MenuFlyout><MenuFlyoutItem Text="Copy original message" Tag="{x:Bind Body}" Click="CopyOriginal_Click" /><MenuFlyoutItem Text="Save attachments…" Tag="{x:Bind}" Click="SaveFiles_Click" /></MenuFlyout>
                    </Border.ContextFlyout>
                </Border>
            </DataTemplate>
            <local:MessageTemplateSelector x:Key="MessageTemplateSelector"
                Incoming="{StaticResource IncomingMessage}" Outgoing="{StaticResource OutgoingMessage}" />
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewConversation_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SenderSearch_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Refresh_Invoked" />
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="Send_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <InfoBar Grid.Row="0" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
                 Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        <Grid x:Name="InboxLayout" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SenderColumn" Width="304" />
                <ColumnDefinition x:Name="SenderDividerColumn" Width="5" />
                <ColumnDefinition x:Name="SubjectColumn" Width="0" />
                <ColumnDefinition x:Name="SubjectDividerColumn" Width="0" />
                <ColumnDefinition x:Name="MessageColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="SenderPane" Padding="16,20,12,12" RowSpacing="16" Background="{ThemeResource NavigationSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/Logo.png" Width="30" Height="30" AutomationProperties.Name="Pigeonpost" />
                    <TextBlock Grid.Column="1" Text="Pigeonpost" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Click="NewConversation_Click" Style="{StaticResource QuietIconButton}" AutomationProperties.Name="New conversation" ToolTipService.ToolTip="New conversation (Ctrl+N)">
                        <FontIcon Glyph="&#xE8F2;" FontSize="18" />
                    </Button>
                </Grid>
                <ComboBox Grid.Row="1" ItemsSource="{x:Bind ViewModel.Mailboxes, Mode=OneWay}" DisplayMemberPath="DisplayName"
                          SelectedItem="{x:Bind ViewModel.SelectedMailbox, Mode=OneWay}" SelectionChanged="Mailbox_SelectionChanged"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Mailbox" ToolTipService.ToolTip="Choose the mailbox you send from" />
                <TextBox x:Name="SenderSearchBox" Grid.Row="2" PlaceholderText="Search conversations"
                         Text="{x:Bind ViewModel.SenderSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search senders" />
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ComboBox SelectedIndex="0" SelectionChanged="ArchiveFilter_SelectionChanged" AutomationProperties.Name="Conversation filter" MinWidth="108">
                        <ComboBoxItem Content="Inbox" /><ComboBoxItem Content="Archived" />
                    </ComboBox>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.InboxSummary, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Grid Grid.Row="4" Margin="-8,0,-4,0">
                    <ListView x:Name="ConversationList" ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=OneWay}"
                              SelectionChanged="Conversation_SelectionChanged" IsItemClickEnabled="True" ItemClick="Conversation_ItemClick"
                              SelectionMode="Single" AutomationProperties.Name="Conversations" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="0,2" /></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Conversation">
                                <Grid Padding="0,8" ColumnSpacing="10" AutomationProperties.Name="{x:Bind AccessibleSummary}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copy address" Tag="{x:Bind Peer}" Click="CopyPeer_Click" /></MenuFlyout></Grid.ContextFlyout>
                                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Background="{ThemeResource AvatarSurfaceBrush}">
                                        <TextBlock Text="{x:Bind Initials}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AvatarTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Peer}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ActivityLabel}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Preview}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Border Grid.Column="1" MinWidth="20" Padding="5,1" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{Binding HasUnread, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="{x:Bind UnreadLabel}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <Border Padding="6,2" CornerRadius="4" HorizontalAlignment="Left" Background="{ThemeResource ReviewSurfaceBrush}" Visibility="{Binding HasHeld, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="{x:Bind ReviewLabel}" FontSize="11" Foreground="{ThemeResource ReviewTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ViewModel.EmptyListMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="16,24"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"
                               Visibility="{x:Bind ToVisibility(ViewModel.IsListEmpty), Mode=OneWay}" />
                </Grid>
            </Grid>
            <Thumb x:Name="SenderDivider" Grid.Column="1" DragDelta="SenderColumn_DragDelta" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize conversations column" />
            <Grid x:Name="SubjectPane" Grid.Column="2" Padding="12,22,12,12" RowSpacing="16" Visibility="Collapsed" Background="{ThemeResource NavigationSurfaceBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Subjects" FontSize="18" FontWeight="SemiBold" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Subjects, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=OneWay}"
                          SelectionChanged="Subject_SelectionChanged" SelectionMode="Single" AutomationProperties.Name="Subjects">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:Subject">
                            <StackPanel Padding="2,8" Spacing="5">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Grid.Row="2" Content="New subject" Click="NewSubject_Click" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
            </Grid>
            <Thumb x:Name="SubjectDivider" Grid.Column="3" DragDelta="SubjectColumn_DragDelta" Style="{StaticResource PaneDivider}" Visibility="Collapsed" AutomationProperties.Name="Resize subjects column" />
            <Grid x:Name="MessagingArea" Grid.Column="4" Background="{ThemeResource ConversationSurfaceBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,16,16,14">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource QuietIconButton}" Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.Name="Back to conversations" ToolTipService.ToolTip="Back to conversations"><SymbolIcon Symbol="Back" /></Button>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <HyperlinkButton Click="Contact_Click" Padding="0" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Sender details">
                                    <TextBlock Text="{x:Bind ViewModel.ConversationTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </HyperlinkButton>
                                <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <HyperlinkButton Click="Contact_Click" Padding="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalContentAlignment="Left"
                                                     IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Sender address details">
                                        <TextBlock Text="{x:Bind ViewModel.ConversationAddress, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                    <Button Grid.Column="1" Click="CopyPeer_Click" Padding="4" Background="Transparent" BorderThickness="0" IsEnabled="{x:Bind ViewModel.HasConversation, Mode=OneWay}" AutomationProperties.Name="Copy address" ToolTipService.ToolTip="Copy address"><FontIcon Glyph="&#xE8C8;" FontSize="12" /></Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                <Button x:Name="FindButton" Click="Find_Click" Style="{StaticResource QuietIconButton}" IsEnabled="{x:Bind ViewModel.HasConversation, Mode=OneWay}" AutomationProperties.Name="Find messages" ToolTipService.ToolTip="Find in this subject (Ctrl+F)"><SymbolIcon Symbol="Find" /></Button>
                                <Button Style="{StaticResource QuietIconButton}" AutomationProperties.Name="Conversation actions" ToolTipService.ToolTip="Conversation actions">
                                    <SymbolIcon Symbol="More" />
                                    <Button.Flyout><MenuFlyout>
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ArchiveAction, Mode=OneWay}" Click="Archive_Click" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Refresh" Click="Refresh_Click" />
                                        <MenuFlyoutItem Text="Sender details" Click="Contact_Click" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                                    </MenuFlyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SubjectSelector" ItemsSource="{x:Bind ViewModel.Subjects, Mode=OneWay}" DisplayMemberPath="Name"
                                      SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=OneWay}" SelectionChanged="Subject_SelectionChanged"
                                      IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" HorizontalAlignment="Left" MinWidth="132" MaxWidth="320" AutomationProperties.Name="Current subject" ToolTipService.ToolTip="Switch subject" />
                            <Button Grid.Column="1" Style="{StaticResource QuietIconButton}" AutomationProperties.Name="Subject actions" ToolTipService.ToolTip="Subject actions" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}">
                                <SymbolIcon Symbol="More" />
                                <Button.Flyout><MenuFlyout>
                                    <MenuFlyoutItem Text="New subject" Click="NewSubject_Click" />
                                    <MenuFlyoutItem Text="Delete subject…" Click="DeleteSubject_Click" IsEnabled="{x:Bind ViewModel.CanDeleteSubject, Mode=OneWay}" />
                                </MenuFlyout></Button.Flyout>
                            </Button>
                            <ToggleButton x:Name="PinSubjectsButton" Grid.Column="2" Checked="PinSubjects_Click" Unchecked="PinSubjects_Click" Padding="8" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Pin subjects" ToolTipService.ToolTip="Pin the subjects pane on wide windows"><FontIcon Glyph="&#xE840;" FontSize="18" /></ToggleButton>
                        </Grid>
                    </Grid>
                </Border>
                <Grid x:Name="FindBar" Grid.Row="1" Margin="20,12,20,0" ColumnSpacing="6" RowSpacing="4" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox" PlaceholderText="Find in this subject" Text="{x:Bind ViewModel.Find, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find in this subject" KeyDown="FindBox_KeyDown" />
                    <Button Grid.Column="1" Content="↑" Click="PreviousMatch_Click" AutomationProperties.Name="Previous match" />
                    <Button Grid.Column="2" Content="↓" Click="NextMatch_Click" AutomationProperties.Name="Next match" />
                    <Button Grid.Column="3" Click="CloseFind_Click" Style="{StaticResource QuietIconButton}" AutomationProperties.Name="Close search" ToolTipService.ToolTip="Close search (Esc)"><SymbolIcon Symbol="Cancel" /></Button>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{x:Bind ViewModel.FindSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,8">
                    <ListView x:Name="MessageList" ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}" SelectionMode="Single"
                              ItemTemplateSelector="{StaticResource MessageTemplateSelector}" AutomationProperties.Name="Messages"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" /></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="AllowDrop" Value="True" /></Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" IsHitTestVisible="False" />
                </Grid>
                <Border Grid.Row="3" Margin="16,0,16,16" Padding="8" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer MaxHeight="120" Visibility="{x:Bind ToVisibility(ViewModel.HasDraftAttachments), Mode=OneWay}" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DraftAttachments, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Attached files">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:DraftAttachment">
                                        <Border CornerRadius="8" Background="{ThemeResource NavigationSurfaceBrush}" Padding="8" Margin="2,2,2,4">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Tag="{x:Bind}" Width="48" Height="40" CornerRadius="6" Loaded="AttachmentPreview_Loaded" Unloaded="AttachmentPreview_Unloaded" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Filename}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" ToolTipService.ToolTip="{x:Bind Filename}" />
                                                <Button Grid.Column="2" Tag="{x:Bind}" Click="RemoveAttachment_Click" Style="{StaticResource QuietIconButton}" AutomationProperties.Name="{x:Bind RemoveLabel}" ToolTipService.ToolTip="Remove attachment"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBox x:Name="Composer" Grid.Row="1" Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Write a message…"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="144" MaxLength="20000" BorderThickness="0" Background="Transparent" FontSize="15"
                                 IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Message" Paste="Composer_Paste">
                            <TextBox.KeyboardAccelerators>
                                <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAttachment_Invoked" />
                                <KeyboardAccelerator Key="Insert" Modifiers="Shift" Invoked="PasteAttachment_Invoked" />
                            </TextBox.KeyboardAccelerators>
                        </TextBox>
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button Click="Attach_Click" Style="{StaticResource QuietIconButton}" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" AutomationProperties.Name="Attach files…" ToolTipService.ToolTip="Attach files or paste from clipboard"><SymbolIcon Symbol="Attach" /></Button>
                            <TextBlock Grid.Column="1" Text="Ctrl+Enter to send" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Column="2" Content="Send" Click="Send_Click" Padding="20,6" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanCompose, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <StackPanel x:Name="Welcome" Grid.RowSpan="3" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Margin="32">
            <Image Source="ms-appx:///Assets/Logo.png" Width="80" Height="80" AutomationProperties.Name="Pigeonpost" />
            <TextBlock Text="Your agents, in one place" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Conversations with your people and agents, organized by mailbox and subject." TextWrapping="Wrap" TextAlignment="Center" FontSize="16" />
            <TextBlock x:Name="AuthStatus" Text="Sign in or create a free Pigeonpost account in your browser." TextWrapping="Wrap" TextAlignment="Center" IsTextSelectionEnabled="True" />
            <ProgressRing x:Name="SignInProgress" IsActive="False" Width="28" Height="28" />
            <StackPanel x:Name="CodePanel" Visibility="Collapsed" Spacing="12">
                <TextBlock x:Name="CodeLabel" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" IsTextSelectionEnabled="True" AutomationProperties.Name="Sign-in code" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button Content="Copy code" Click="CopyCode_Click" />
                    <Button Content="Open browser" Click="OpenSignIn_Click" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="SignInButton" Content="Sign in or create account" Click="SignIn_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="CancelSignIn" Content="Cancel sign-in" Click="CancelSignIn_Click" HorizontalAlignment="Center" Visibility="Collapsed" />
            <HyperlinkButton Content="Privacy policy" Click="Privacy_Click" HorizontalAlignment="Center" />
        </StackPanel>
        <Border x:Name="EmptyAccount" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32">
            <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="Connect your first mailbox" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Create a free mailbox to start conversations with your people and agents. Already have a mailbox? Refresh to load it." TextWrapping="Wrap" />
                <Button Content="Create free mailbox" Click="CreateMailbox_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Refresh mailboxes" Click="ReloadAccount_Click" />
            </StackPanel>
        </Border>
        <Border x:Name="AccountBar" Grid.Row="2" Visibility="Collapsed" Background="{ThemeResource NavigationSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Background="Transparent" BorderThickness="0" Padding="6" AutomationProperties.Name="Account" ToolTipService.ToolTip="Account and settings">
                    <SymbolIcon Symbol="Contact" />
                    <Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="Copy my address" Click="CopyAddress_Click" />
                        <MenuFlyoutItem Text="Manage account" Click="ManageAccount_Click" />
                        <MenuFlyoutItem Text="Privacy policy" Click="Privacy_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="{x:Bind BuildLabel}" IsEnabled="False" />
                        <MenuFlyoutItem Text="Sign out" Click="SignOut_Click" />
                    </MenuFlyout></Button.Flyout>
                </Button>
                <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SendingAsLabel" Text="Sending as" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MailboxAddress, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.MailboxAddress, Mode=OneWay}" />
                </Grid>
                <TextBlock x:Name="AccountStatus" Grid.Column="2" Text="Connected" MaxWidth="220" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>

            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F1F3F6" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E8EBF0" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D5DAE1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C6CCD5" />

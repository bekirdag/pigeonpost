<Application
    x:Class="Pigeonpost.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Typography: Geist / Geist Mono (SIL OFL 1.1, Assets/Fonts/OFL.txt) with system fallbacks. -->
            <FontFamily x:Key="SansFont">ms-appx:///Assets/Fonts/Geist-Variable.ttf#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/GeistMono-Variable.ttf#Geist Mono, Cascadia Mono, Consolas</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Geist-Variable.ttf#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>

            <!-- Accent hue family of the design (#8AB4FF). Dark surfaces use Light2, light surfaces Dark1. -->
            <Color x:Key="SystemAccentColor">#5B8DEF</Color>
            <Color x:Key="SystemAccentColorLight1">#73A0F7</Color>
            <Color x:Key="SystemAccentColorLight2">#8AB4FF</Color>
            <Color x:Key="SystemAccentColorLight3">#B5CEFF</Color>
            <Color x:Key="SystemAccentColorDark1">#3466D1</Color>
            <Color x:Key="SystemAccentColorDark2">#2A54AE</Color>
            <Color x:Key="SystemAccentColorDark3">#1F418A</Color>

            <!-- Shape language: soft 8-10px controls, 14px cards, 16px dialogs. -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DialogBorderBrush}" />
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource AccentButtonStyle}" />
                <Setter Property="TitleTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="17" FontWeight="SemiBold" CharacterSpacing="-10" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="12,8,10,8" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DialogBorderBrush" Color="#DADFE6" />
                    <!-- Surfaces -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#F3F4F7" />
                    <SolidColorBrush x:Key="ThreadsSurfaceBrush" Color="#F8F9FB" />
                    <SolidColorBrush x:Key="ConversationSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#E3E6EB" />
                    <SolidColorBrush x:Key="RowHoverBrush" Color="#ECEFF3" />
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E4E9F1" />
                    <SolidColorBrush x:Key="FieldSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="#DADFE6" />
                    <SolidColorBrush x:Key="IconButtonSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="IconButtonBorderBrush" Color="#DFE3E9" />
                    <!-- Text -->
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#15181D" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#59626E" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7D8590" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#3466D1" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <!-- Message cards -->
                    <SolidColorBrush x:Key="IncomingMessageBrush" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="IncomingBorderBrush" Color="#E3E6EB" />
                    <SolidColorBrush x:Key="IncomingTextBrush" Color="#1F242B" />
                    <SolidColorBrush x:Key="IncomingFooterBorderBrush" Color="#E8EBEF" />
                    <SolidColorBrush x:Key="IncomingFooterTextBrush" Color="#6B7480" />
                    <SolidColorBrush x:Key="OutgoingMessageBrush" Color="#EEF3FE" />
                    <SolidColorBrush x:Key="OutgoingBorderBrush" Color="#CCDAF5" />
                    <SolidColorBrush x:Key="OutgoingTextBrush" Color="#172443" />
                    <SolidColorBrush x:Key="OutgoingFooterBorderBrush" Color="#DAE3F6" />
                    <SolidColorBrush x:Key="OutgoingFooterTextBrush" Color="#53628A" />
                    <SolidColorBrush x:Key="ChipSurfaceBrush" Color="#EAEDF1" />
                    <SolidColorBrush x:Key="ChipTextBrush" Color="#3F4752" />
                    <SolidColorBrush x:Key="AttachmentSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AttachmentBorderBrush" Color="#DFE3E9" />
                    <!-- Badges -->
                    <SolidColorBrush x:Key="AvatarSurfaceBrush" Color="#DCE7FB" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="#2D5BB4" />
                    <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="#FBEFD3" />
                    <SolidColorBrush x:Key="ReviewTextBrush" Color="#8A5A00" />
                    <!-- Composer -->
                    <SolidColorBrush x:Key="ComposerSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComposerBorderBrush" Color="#D9DEE5" />
                    <SolidColorBrush x:Key="ComposerAreaBrush" Color="#FAFBFC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#171B21" />
                    <SolidColorBrush x:Key="DialogBorderBrush" Color="#2A3039" />
                    <!-- Exact values from the design mockup. -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D0F12" />
                    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#111419" />
                    <SolidColorBrush x:Key="ThreadsSurfaceBrush" Color="#13161B" />
                    <SolidColorBrush x:Key="ConversationSurfaceBrush" Color="#0F1216" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#1F242B" />
                    <SolidColorBrush x:Key="RowHoverBrush" Color="#171B21" />
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="#1C2129" />
                    <SolidColorBrush x:Key="FieldSurfaceBrush" Color="#171B21" />
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="#252A32" />
                    <SolidColorBrush x:Key="IconButtonSurfaceBrush" Color="#13161B" />
                    <SolidColorBrush x:Key="IconButtonBorderBrush" Color="#252A32" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAED" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3AE" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7D8590" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#8AB4FF" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#0D0F12" />
                    <SolidColorBrush x:Key="IncomingMessageBrush" Color="#171B21" />
                    <SolidColorBrush x:Key="IncomingBorderBrush" Color="#262B33" />
                    <SolidColorBrush x:Key="IncomingTextBrush" Color="#D7DCE3" />
                    <SolidColorBrush x:Key="IncomingFooterBorderBrush" Color="#22272F" />
                    <SolidColorBrush x:Key="IncomingFooterTextBrush" Color="#7D8590" />
                    <SolidColorBrush x:Key="OutgoingMessageBrush" Color="#131C2E" />
                    <SolidColorBrush x:Key="OutgoingBorderBrush" Color="#263556" />
                    <SolidColorBrush x:Key="OutgoingTextBrush" Color="#E6ECF8" />
                    <SolidColorBrush x:Key="OutgoingFooterBorderBrush" Color="#1F2C47" />
                    <SolidColorBrush x:Key="OutgoingFooterTextBrush" Color="#8C9AB8" />
                    <SolidColorBrush x:Key="ChipSurfaceBrush" Color="#1E232B" />
                    <SolidColorBrush x:Key="ChipTextBrush" Color="#C3C9D1" />
                    <SolidColorBrush x:Key="AttachmentSurfaceBrush" Color="#1B1F26" />
                    <SolidColorBrush x:Key="AttachmentBorderBrush" Color="#2A3039" />
                    <SolidColorBrush x:Key="AvatarSurfaceBrush" Color="#17263F" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="#8DB4F5" />
                    <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="#2A2213" />
                    <SolidColorBrush x:Key="ReviewTextBrush" Color="#F0B860" />
                    <SolidColorBrush x:Key="ComposerSurfaceBrush" Color="#151920" />
                    <SolidColorBrush x:Key="ComposerBorderBrush" Color="#2A3039" />
                    <SolidColorBrush x:Key="ComposerAreaBrush" Color="#0F1216" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DialogBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ThreadsSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ConversationSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="RowHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FieldSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IconButtonSurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="IconButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="IncomingMessageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="IncomingBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IncomingTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IncomingFooterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IncomingFooterTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OutgoingMessageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OutgoingBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OutgoingTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OutgoingFooterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OutgoingFooterTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ChipSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ChipTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AttachmentSurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AttachmentBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AvatarSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ReviewTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ComposerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ComposerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ComposerAreaBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Application
    x:Class="Pigeonpost.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Pigeonpost Design Kit tokens (generated by the kit's tools/build_tokens.py; copy, do not edit).
                     The app's own brushes below carry the same values; DesignTokenTests keeps them in step. -->
                <ResourceDictionary Source="ms-appx:///Themes/PPTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Typography: Geist / Geist Mono (SIL OFL 1.1, Assets/Fonts/OFL.txt) with system fallbacks. -->
            <FontFamily x:Key="SansFont">ms-appx:///Assets/Fonts/Geist-Variable.ttf#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/GeistMono-Variable.ttf#Geist Mono, Cascadia Mono, Consolas</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Geist-Variable.ttf#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>

            <!-- Accent: Signal Blue (pp-blue-500, #086CFF) and its scale, so stock controls match the kit. -->
            <Color x:Key="SystemAccentColor">#086CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#4A90FF</Color>
            <Color x:Key="SystemAccentColorLight2">#80B1FF</Color>
            <Color x:Key="SystemAccentColorLight3">#B3D0FF</Color>
            <Color x:Key="SystemAccentColorDark1">#0A5FE0</Color>
            <Color x:Key="SystemAccentColorDark2">#0B4FB8</Color>
            <Color x:Key="SystemAccentColorDark3">#0D418F</Color>

            <!-- Shape (kit radii): controls radius-m 10, overlays radius-l 14, dialogs radius-xl 18. -->
            <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="CornerRadius" Value="{StaticResource PPRadiusXl}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DialogBorderBrush}" />
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource AccentButtonStyle}" />
                <Setter Property="TitleTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="{StaticResource PPFontSizeH3}" FontWeight="SemiBold" CharacterSpacing="-10" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="CornerRadius" Value="{StaticResource PPRadiusM}" />
                <Setter Property="Padding" Value="12,8,10,8" />
                <Setter Property="MinHeight" Value="{StaticResource PPControlM}" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Dialogs -->
                    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DialogBorderBrush" Color="#E1E5EA" />
                    <!-- Surfaces: sender list and subjects on bg-subtle, the conversation on bg, its header on surface -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F8" />
                    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#FAFBFC" />
                    <SolidColorBrush x:Key="ThreadsSurfaceBrush" Color="#FAFBFC" />
                    <SolidColorBrush x:Key="ConversationSurfaceBrush" Color="#F4F6F8" />
                    <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#E1E5EA" />
                    <SolidColorBrush x:Key="RowHoverBrush" Color="#EEF1F5" />
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E4EBF7" />
                    <SolidColorBrush x:Key="FieldSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="#C9CFD8" />
                    <SolidColorBrush x:Key="IconButtonSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="IconButtonBorderBrush" Color="#E1E5EA" />
                    <!-- Text. AccentBrush is accent-coloured text (links, quotes); AccentFillBrush fills badges. -->
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#12161C" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#59626E" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#636C78" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#0A5FE0" />
                    <SolidColorBrush x:Key="AccentFillBrush" Color="#086CFF" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <!-- Message bubbles: theirs neutral, mine Signal Blue tinted -->
                    <SolidColorBrush x:Key="IncomingMessageBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="IncomingBorderBrush" Color="#E1E5EA" />
                    <SolidColorBrush x:Key="IncomingTextBrush" Color="#12161C" />
                    <SolidColorBrush x:Key="IncomingFooterBorderBrush" Color="#ECEEF2" />
                    <SolidColorBrush x:Key="IncomingFooterTextBrush" Color="#636C78" />
                    <SolidColorBrush x:Key="OutgoingMessageBrush" Color="#EAF1FE" />
                    <SolidColorBrush x:Key="OutgoingBorderBrush" Color="#C8D9FA" />
                    <SolidColorBrush x:Key="OutgoingTextBrush" Color="#13203B" />
                    <SolidColorBrush x:Key="OutgoingFooterBorderBrush" Color="#C8D9FA" />
                    <SolidColorBrush x:Key="OutgoingFooterTextBrush" Color="#9E13203B" />
                    <!-- Receipts: grey sent/delivered, green seen and agent working, red failure -->
                    <SolidColorBrush x:Key="TickSentBrush" Color="#7C8594" />
                    <SolidColorBrush x:Key="TickSeenBrush" Color="#1E8A50" />
                    <SolidColorBrush x:Key="TickWorkingBrush" Color="#1DA824" />
                    <SolidColorBrush x:Key="TickFailedBrush" Color="#C42B2B" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#15801D" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C42B2B" />
                    <SolidColorBrush x:Key="DangerFillBrush" Color="#FDF0EF" />
                    <SolidColorBrush x:Key="ChipSurfaceBrush" Color="#EEF1F5" />
                    <SolidColorBrush x:Key="ChipTextBrush" Color="#343C47" />
                    <SolidColorBrush x:Key="AttachmentSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AttachmentBorderBrush" Color="#E1E5EA" />
                    <!-- Badges -->
                    <SolidColorBrush x:Key="AvatarSurfaceBrush" Color="#EDF4FF" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="#0A5FE0" />
                    <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="#FDF3E1" />
                    <SolidColorBrush x:Key="ReviewTextBrush" Color="#8A5208" />
                    <!-- Composer -->
                    <SolidColorBrush x:Key="ComposerSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComposerBorderBrush" Color="#E1E5EA" />
                    <SolidColorBrush x:Key="ComposerFocusBorderBrush" Color="#086CFF" />
                    <SolidColorBrush x:Key="ComposerAreaBrush" Color="#F4F6F8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <!-- Dark: the kit's dark roles. -->
                    <!-- Dialogs -->
                    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#1A1F28" />
                    <SolidColorBrush x:Key="DialogBorderBrush" Color="#232A35" />
                    <!-- Surfaces: sender list and subjects on bg-subtle, the conversation on bg, its header on surface -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0E12" />
                    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#0F1217" />
                    <SolidColorBrush x:Key="ThreadsSurfaceBrush" Color="#0F1217" />
                    <SolidColorBrush x:Key="ConversationSurfaceBrush" Color="#0B0E12" />
                    <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="#141820" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#232A35" />
                    <SolidColorBrush x:Key="RowHoverBrush" Color="#1D232D" />
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="#1C2840" />
                    <SolidColorBrush x:Key="FieldSurfaceBrush" Color="#141820" />
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="#343D4A" />
                    <SolidColorBrush x:Key="IconButtonSurfaceBrush" Color="#141820" />
                    <SolidColorBrush x:Key="IconButtonBorderBrush" Color="#232A35" />
                    <!-- Text. AccentBrush is accent-coloured text (links, quotes); AccentFillBrush fills badges. -->
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F7" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3ACB9" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A93A0" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#6EA8FF" />
                    <SolidColorBrush x:Key="AccentFillBrush" Color="#086CFF" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <!-- Message bubbles: theirs neutral, mine Signal Blue tinted -->
                    <SolidColorBrush x:Key="IncomingMessageBrush" Color="#1A1F28" />
                    <SolidColorBrush x:Key="IncomingBorderBrush" Color="#262D38" />
                    <SolidColorBrush x:Key="IncomingTextBrush" Color="#F2F4F7" />
                    <SolidColorBrush x:Key="IncomingFooterBorderBrush" Color="#1C222B" />
                    <SolidColorBrush x:Key="IncomingFooterTextBrush" Color="#8A93A0" />
                    <SolidColorBrush x:Key="OutgoingMessageBrush" Color="#17325E" />
                    <SolidColorBrush x:Key="OutgoingBorderBrush" Color="#23477F" />
                    <SolidColorBrush x:Key="OutgoingTextBrush" Color="#EAF1FE" />
                    <SolidColorBrush x:Key="OutgoingFooterBorderBrush" Color="#23477F" />
                    <SolidColorBrush x:Key="OutgoingFooterTextBrush" Color="#9EEAF1FE" />
                    <!-- Receipts: grey sent/delivered, green seen and agent working, red failure -->
                    <SolidColorBrush x:Key="TickSentBrush" Color="#8A93A0" />
                    <SolidColorBrush x:Key="TickSeenBrush" Color="#4FDB55" />
                    <SolidColorBrush x:Key="TickWorkingBrush" Color="#1DA824" />
                    <SolidColorBrush x:Key="TickFailedBrush" Color="#FF6B6B" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#4FDB55" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
                    <SolidColorBrush x:Key="DangerFillBrush" Color="#2B1416" />
                    <SolidColorBrush x:Key="ChipSurfaceBrush" Color="#1D232D" />
                    <SolidColorBrush x:Key="ChipTextBrush" Color="#D3D8E0" />
                    <SolidColorBrush x:Key="AttachmentSurfaceBrush" Color="#141820" />
                    <SolidColorBrush x:Key="AttachmentBorderBrush" Color="#232A35" />
                    <!-- Badges -->
                    <SolidColorBrush x:Key="AvatarSurfaceBrush" Color="#13233F" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="#6EA8FF" />
                    <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="#2A2010" />
                    <SolidColorBrush x:Key="ReviewTextBrush" Color="#F5B547" />
                    <!-- Composer -->
                    <SolidColorBrush x:Key="ComposerSurfaceBrush" Color="#141820" />
                    <SolidColorBrush x:Key="ComposerBorderBrush" Color="#232A35" />
                    <SolidColorBrush x:Key="ComposerFocusBorderBrush" Color="#086CFF" />
                    <SolidColorBrush x:Key="ComposerAreaBrush" Color="#0B0E12" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DialogBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ThreadsSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ConversationSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="RowHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FieldSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IconButtonSurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="IconButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="IncomingMessageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="IncomingBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IncomingTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IncomingFooterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IncomingFooterTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OutgoingMessageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OutgoingBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OutgoingTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OutgoingFooterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OutgoingFooterTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TickSeenBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TickFailedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ChipSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ChipTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AttachmentSurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AttachmentBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AvatarSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ReviewTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ComposerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ComposerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ComposerAreaBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AccentFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TickSentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TickWorkingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DangerFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ComposerFocusBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

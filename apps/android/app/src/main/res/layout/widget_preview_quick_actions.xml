<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for Android 12-14 (Android 15+ draws a generated one). The launcher inflates it
     as RemoteViews, without AppCompat, so android:tint is the attribute that works. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,ContentDescription,UseCompoundDrawables,UseAppTint"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background" android:padding="6dp"
    android:orientation="horizontal" android:gravity="center">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_horizontal">
        <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_preview_pill">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center"
                android:src="@drawable/pp_ic_pencil" android:tint="@color/widget_on_accent" />
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:text="New" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_text" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_horizontal">
        <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_preview_avatar_blue">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center"
                android:src="@drawable/pp_ic_inbox" android:tint="@color/widget_link" />
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:text="Inbox" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_text" />
    </LinearLayout>
</LinearLayout>

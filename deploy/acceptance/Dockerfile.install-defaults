ARG RUNTIME_BASE=docker.io/library/debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258
FROM ${RUNTIME_BASE}

# Acceptance-only tooling. The product image remains lean; this derived disposable image adds the
# real systemd parser and SQLite inspector without replacing or rebuilding the tested binary.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates=20250419 \
      curl=8.14.1-2+deb13u4 \
      tini=0.19.0-3+b7 \
      sqlite3=3.46.1-7+deb13u1 \
      systemd=257.13-1~deb13u1 \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 pigeonpost \
 && useradd --uid 10001 --gid 10001 --home-dir /var/lib/pigeonpost --create-home pigeonpost

COPY --chown=0:0 pigeonpost /usr/local/bin/pigeonpost

USER pigeonpost
WORKDIR /var/lib/pigeonpost
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/pigeonpost"]
CMD ["--help"]

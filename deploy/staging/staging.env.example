# Staging postbox environment (marketplace M2b). Copy to ~/pp-staging/staging.env, chmod 600, and
# replace every <placeholder>. Placeholders only: no value here is real. Never reuse a production
# value (OD-9): not the realm client, not a token, not the vault key.
#
# compose.yaml sets POSTBOX_STAGING_MODE=1, the binds, the database path and the vault key path.

POSTBOX_PUBLIC_URL=https://<staging-domain>
REGISTRY_URL=https://<staging-registry-or-production-registry-url>

# The staging realm client (its own client, or its own realm). Never the production client.
OIDC_ISSUER=https://<keycloak-host>/realms/<staging-realm>
OIDC_AUDIENCE=<staging-audience>
OIDC_CLIENT_ID=<staging-client-id>

# Who may assign staff roles on staging (the owner's account id in the staging realm).
POSTBOX_PLATFORM_OWNER_ACCOUNT=<staging-owner-account-id>

# Internal API service tokens: svc_ followed by at least 32 characters, e.g.
#   echo "svc_$(openssl rand -hex 32)"
# OPS is what the build plane, the analysis plane and the operator use on staging.
POSTBOX_SVC_TOKEN_OPS=<svc_staging_ops_token>

POW_HMAC_SECRET=<openssl rand -hex 32>
POW_MIN_BITS=18
POW_MAX_BITS=26
TRUSTED_PROXY_HOPS=1

# Hosted test Nests: the test pool's nestd on this host, on the pp-staging bridge gateway.
# Its control token's SHA-256 goes in that nestd's token_sha256_file. Never the production nestd.
POSTBOX_MARKETPLACE_TEST_NESTS_URL=http://10.89.40.1:8790
POSTBOX_MARKETPLACE_TEST_NESTS_TOKEN=<openssl rand -hex 32>
POSTBOX_MARKETPLACE_TEST_NEST_DAYS=7
POSTBOX_MARKETPLACE_GIT_HOSTS=github.com,gitlab.com,codeberg.org

# Leave unset on staging: no production Nests host, no billing, no mail or SMS providers.
# POSTBOX_NESTS_URL=
# POSTBOX_NESTS_TOKEN=
# POSTBOX_SVC_TOKEN_BILLING=
# POSTBOX_NOTIFY_URL=
# POSTBOX_SMS_URL=

#!/usr/sbin/nft -f
# /etc/nftables.d/nestbuild.nft — the build plane's network policy on its host.
#
# Everything the build plane does runs as the unprivileged user `nestbuild`: the service itself
# and every rootless podman container it starts. Rootless podman's network (pasta) turns a
# container's connections into ordinary sockets owned by that user, so one rule set on the
# OUTPUT hook, matched by `meta skuid`, covers publisher code too. The build step itself runs
# with --network=none and has no traffic at all.
#
# nestbuild may open connections to exactly:
#   - DNS on the host's resolver (git and cargo resolve the allowlisted names),
#   - TCP 443 on the git host and package registry allowlist (@fetch_v4, filled by
#     nestbuild-allowlist from allowlist.txt), and TCP 22 on the same set for deploy-key sources,
#   - optionally, the postbox's source-credential route over the tunnel (@credential_v4 on
#     @credential_ports; empty by default, so the build plane initiates nothing on wg-nestbuild),
#   - the self-hosted model route for the advisory AI review (@model_v4, TCP @model_ports).
# The scans themselves (OSV-Scanner, Grype, ClamAV, YARA, Semgrep, gitleaks) and the behaviour
# run use --network=none and have no traffic at all.
#
# The scanner database updater runs as a second user, `nestscan` (nestscan-update), with a chain
# of its own: DNS on the resolvers and TCP 443 to @scandb_v4 (filled from scandb-allowlist.txt by
# nestbuild-allowlist), nothing else. Create the user before loading this file: nft refuses a
# rule that names an unknown user.
# Nothing else: not loopback (Keycloak, saas_be, mswarm and Docker publish ports there and on the
# Docker bridges), not the Docker bridges or any other private range, not link-local/metadata,
# not IPv6, not other hosts.
#
# Inbound, the build API (TCP 8795) is reachable on wg-nestbuild only, from the postbox host and
# nests-1 only.
#
# Drops in a base chain are final in nftables whatever other tables (ufw, Docker) say, so these
# chains run early (priority -10) and only drop or fall through. Docker's own tables are untouched.
# Reload: nft -f /etc/nftables.d/nestbuild.nft

table inet nestbuild
delete table inet nestbuild

table inet nestbuild {
	# Filled by nestbuild-allowlist (resolved A records of allowlist.txt). Starts empty: until the
	# timer has run once, nothing can be fetched, which is the safe direction.
	set fetch_v4 {
		type ipv4_addr
		flags interval
		auto-merge
	}

	# The self-hosted model route (mswarm's self-hosted load balancer), by address.
	set model_v4 {
		type ipv4_addr
		flags interval
		# elements = { <MODEL_ROUTE_ADDR> }
	}

	set model_ports {
		type inet_service
		# elements = { <MODEL_ROUTE_PORT> }
	}

	# The postbox's WireGuard address and internal port, for deploy-key sources only (M2b). Leave
	# empty unless [postbox] is set in buildd.toml; the token it uses opens that one route.
	set credential_v4 {
		type ipv4_addr
		# elements = { <POSTBOX_WG_ADDR> }
	}

	set credential_ports {
		type inet_service
		# elements = { <POSTBOX_INTERNAL_PORT> }
	}

	# The host's DNS resolvers. Include the systemd-resolved stub 127.0.0.53 when /etc/resolv.conf
	# points at it (the only loopback address nestbuild may reach, port 53 only), plus the upstreams.
	set resolver_v4 {
		type ipv4_addr
		# elements = { <RESOLVER_ADDR> }
	}

	# The scanner databases' hosts (OSV mirror, Grype, ClamAV, YARA-Forge), for user nestscan only.
	# Filled by nestbuild-allowlist from scandb-allowlist.txt; empty until it has run (safe).
	set scandb_v4 {
		type ipv4_addr
		flags interval
		auto-merge
	}

	# WireGuard peers allowed to call the build API.
	set callers_v4 {
		type ipv4_addr
		# elements = { <POSTBOX_WG_ADDR>, <NESTS1_WG_ADDR> }
	}

	chain output {
		type filter hook output priority -10; policy accept;
		# Only sockets owned by nestbuild enter the build-plane rules. Kernel-generated packets
		# (WireGuard UDP, ICMP, RSTs, IPv6 neighbour discovery) have no socket; a negated test
		# ("meta skuid != nestbuild return") lets them fall into the default deny below.
		meta skuid "nestbuild" jump nestbuild_out
		meta skuid "nestscan" jump nestscan_out
	}

	chain nestbuild_out {
		meta nfproto ipv6 counter drop comment "nestbuild: no IPv6"
		ct state established,related return
		oifname "wg-nestbuild" ct state new counter drop comment "nestbuild never initiates on the tunnel"
		ip daddr @resolver_v4 udp dport 53 return
		ip daddr @resolver_v4 tcp dport 53 return
		ip daddr @fetch_v4 tcp dport 443 ct state new return
		ip daddr @model_v4 tcp dport @model_ports ct state new return
		counter drop comment "nestbuild egress default deny"
	}

	# The scanner database updater: DNS, then HTTPS to the database hosts. Never the tunnel, never
	# loopback or a private range, never the build plane's own fetch allowlist.
	chain nestscan_out {
		meta nfproto ipv6 counter drop comment "nestscan: no IPv6"
		ct state established,related return
		oifname "wg-nestbuild" ct state new counter drop comment "nestscan never uses the tunnel"
		ip daddr @resolver_v4 udp dport 53 return
		ip daddr @resolver_v4 tcp dport 53 return
		ip daddr @scandb_v4 tcp dport 443 ct state new return
		counter drop comment "nestscan egress default deny"
	}

	chain input {
		type filter hook input priority -10; policy accept;
		# Scoped to the build API's own address: other services may use TCP 8795 on this host (raijin
		# runs the calls signaling server on 127.0.0.1:8795; an unscoped rule dropped it).
		ip daddr <BUILD_WG_ADDR> tcp dport 8795 iifname != "wg-nestbuild" counter drop comment "build API: tunnel only"
		ip daddr <BUILD_WG_ADDR> tcp dport 8795 ip saddr != @callers_v4 counter drop comment "build API: postbox and nests-1 only"
	}
}

# deploy/nests/buildd/scanners/Containerfile — the analysis plane's scanner image:
# osv-scanner, grype, gitleaks and yara, every binary pinned by version and SHA-256.
#
# Built once by an operator (it needs the network: apt and the GitHub release downloads), then
# loaded into the nestbuild and nestscan users' podman storage and named by digest in
# buildd.toml ([scanners] image). Nothing is ever pulled at scan time (`--pull=never`), and every
# scan runs it under gVisor with --network=none.
#
#   podman build --pull=always -t localhost/pigeonpost-scanners:2026.11 \
#     -f deploy/nests/buildd/scanners/Containerfile deploy/nests/buildd/scanners
#   podman image inspect --format '{{.Digest}}' localhost/pigeonpost-scanners:2026.11
#
# Versions are at least two weeks old when pinned. To upgrade one, change its version and
# checksum together (the checksum is the release asset's published SHA-256), rebuild, and put the
# new image digest in buildd.toml.
ARG DEBIAN=docker.io/library/debian:bookworm-20261020-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

FROM ${DEBIAN} AS fetch
ARG OSV_SCANNER_VERSION=2.7.0
ARG OSV_SCANNER_SHA256=160c6253e2922e9e0a6a9771c5c4c40a4b3c6090b34a3cdd5e80c96cc2e4218b
ARG GRYPE_VERSION=0.121.0
ARG GRYPE_SHA256=64e07133d3486115de647a66581461dccf5c732748a0a3119077395565f15519
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /fetch
RUN set -eu; \
    curl -fsSLo osv-scanner "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64"; \
    echo "${OSV_SCANNER_SHA256}  osv-scanner" | sha256sum -c -; \
    curl -fsSLo grype.tar.gz "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_amd64.tar.gz"; \
    echo "${GRYPE_SHA256}  grype.tar.gz" | sha256sum -c -; \
    curl -fsSLo gitleaks.tar.gz "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"; \
    echo "${GITLEAKS_SHA256}  gitleaks.tar.gz" | sha256sum -c -; \
    tar -xzf grype.tar.gz grype; \
    tar -xzf gitleaks.tar.gz gitleaks; \
    chmod 0755 osv-scanner grype gitleaks

FROM ${DEBIAN}
# YARA 4.5 (YARA-Forge's rules need it) from bookworm-backports, pinned to the exact package.
ARG YARA_VERSION=4.5.2-1~bpo12+1
RUN echo 'deb http://deb.debian.org/debian bookworm-backports main' > /etc/apt/sources.list.d/backports.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends -t bookworm-backports "yara=${YARA_VERSION}" \
 && rm -rf /var/lib/apt/lists/*
COPY --from=fetch /fetch/osv-scanner /fetch/grype /fetch/gitleaks /usr/local/bin/
# The scan never writes outside /out and /tmp (the root is read-only at run time).
USER 0:0
ENTRYPOINT ["/bin/false"]

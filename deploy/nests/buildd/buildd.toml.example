# /etc/pigeonpost-buildd/buildd.toml — the remote build and analysis plane (marketplace hardening
# W1.3). Read by `pigeonpost-nest-buildd serve`; check it with `pigeonpost-nest-buildd check`.
# No secret is in this file: it names files that hold token hashes.

# The build host's WireGuard address (wg-nestbuild) and port. Never 0.0.0.0.
bind = "<BUILD_WG_ADDR>:8795"

db = "/var/lib/pigeonpost-buildd/buildd.db"
# One build at a time works here; both are wiped/pruned by the service.
work_root = "/var/lib/pigeonpost-buildd/work"
artifact_root = "/var/lib/pigeonpost-buildd/artifacts"

# SHA-256 (hex) of the two bearer tokens (`pigeonpost-nest-buildd hash-token < token`). They must
# differ: the postbox's token submits and reads builds; nests-1's token reads images only.
submit_token_sha256_file = "/etc/pigeonpost-buildd/submit-token.sha256"
artifact_token_sha256_file = "/etc/pigeonpost-buildd/artifact-token.sha256"

# Build each release twice from scratch and require the same release digest (R-62).
reproducible = true
# Builds waiting at once, all publishers together. The postbox caps builds per publisher per day.
max_queued = 20
# Saved release images are deleted after this many days (nests-1 keeps its pulled copy).
keep_days = 14
# An image no re-scan has named yet is kept this long (at least keep_days and 45), so the first
# re-scan of a published release always finds it.
keep_unscanned_days = 120

# The advisory AI review on the self-hosted model (mswarm's self-hosted LB). Optional; when unset
# the postbox records the AI stage some other way or the review waits for it.
# ai_review_route = "/etc/pigeonpost-buildd/review.toml"

# The behaviour test after the scan: the built image runs under gVisor with no network,
# honeytokens on its volume, buyer-data canaries in its example jobs, and every job's answer
# checked (on by default). [behaviour] below adds the egress trace and the resource budget.
behaviour_test = true
behaviour_timeout_secs = 60

# Deploy-key sources (marketplace M2b). Optional: without it, builds of SSH repositories are
# refused. The token opens the postbox's source-credential route and nothing else
# (POSTBOX_MARKETPLACE_SOURCE_CREDENTIAL_TOKEN_SHA256 on the postbox side).
# [postbox]
# url = "http://<POSTBOX_WG_ADDR>:<PORT>"
# credential_token_file = "/etc/pigeonpost-buildd/source-credential-token"

[git]
# An image with git, pinned by digest (for example alpine/git), loaded into the nestbuild user's
# podman storage; nothing is pulled at build time.
image = "<GIT_IMAGE>@sha256:<DIGEST>"
# A rootless podman network of its own. nftables lets the nestbuild user reach only the
# allowlisted addresses (nestbuild.nft); this name only keeps git off the default network.
network = "nestbuild-fetch"
# Exact git host names a publisher repository may be on. nestbuild-allowlist resolves these into
# the nftables allowlist; a name here that is not also in allowlist.txt cannot be reached.
allowed_hosts = ["github.com", "codeberg.org"]
# Pinned SSH host keys of the allowed hosts, for deploy-key sources (`ssh-keyscan`, then verify
# the fingerprints against each host's published ones). An unknown host key fails the fetch.
# known_hosts = "/etc/pigeonpost-buildd/known_hosts"

[build]
# gVisor. `runsc` is mapped to the runsc-buildd wrapper in the user's containers.conf.
runtime = "runsc"
# The vendoring step (`cargo vendor --locked`) needs the crates.io registry; same network.
fetch_network = "nestbuild-fetch"
# The Rust toolchain image, pinned by digest: vendoring (`cargo vendor --locked`), and the compile
# step of Rust releases whose nest-build.toml names no image. Use the one the reference release
# pins (deploy/nests/reference/hr-policy-qa/nest-build.toml).
fetch_image = "docker.io/library/rust:<VERSION>-slim-bookworm@sha256:<DIGEST>"
# Node releases (`npm ci --ignore-scripts --omit=dev`) and Python releases
# (`pip download --require-hashes --only-binary=:all:`), each pinned by digest. Use the same
# images the runner Containerfiles of the developer kit pin, so node_modules and the wheels match
# the runtime. Unset: that language is refused.
node_fetch_image = "docker.io/library/node:22.21.1-bookworm-slim@sha256:25b3eb23a00590b7499f2a2ce939322727fcce1b15fdd69754fcd09536a3ae2c"
python_fetch_image = "docker.io/library/python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c"
# Local name the release images are tagged with.
image_name = "localhost/pigeonpost-release"
# More toolchain images a release's nest-build.toml may name (`image = ...`), each pinned by digest
# and loaded into nestbuild's storage. The three fetch images above are always offered.
# toolchain_images = ["docker.io/library/rust:<OTHER_VERSION>-slim-bookworm@sha256:<DIGEST>"]
# The compile step (publisher code, in gVisor with no network) is stopped after this long.
compile_timeout_secs = 1800
# Per-container limits (the nestbuild slice is the hard cap for everything together). pids applies
# to `podman run` only; `podman build` has no such flag and runs nothing (no RUN steps).
memory_mib = 4096
cpu_millis = 2000
pids = 1024

# The security tools of the deterministic scan (developer program plan §4). Every tool runs in
# gVisor with --network=none and read-only mounts; the databases come from nestscan-update.
# Production sets this table: without it only the built-in rules run (an advisory finding says so).
[scanners]
# osv-scanner, grype, gitleaks and yara, built from deploy/nests/buildd/scanners/Containerfile and
# loaded into nestbuild's podman storage; its digest after the build.
image = "localhost/pigeonpost-scanners:2026.11@sha256:<DIGEST>"
# ClamAV 1.4 LTS without bundled signatures (freshclam fills the database).
clamav_image = "docker.io/clamav/clamav:1.4.6_base@sha256:109477fb9dedf7b4542d0fc7be7f8ef73a55d9d731e9568821347825219407aa"
semgrep_image = "docker.io/semgrep/semgrep:1.181.0@sha256:81474464c1f07483ba0682a44787fd93c91397419762a04abe2bafaae396304b"
# The vendored ruleset (deploy/nests/buildd/scanners/semgrep-rules.yml) and its sha256sum.
semgrep_rules = "/etc/pigeonpost-buildd/semgrep-rules.yml"
semgrep_rules_sha256 = "f4c7be3fb24404303451c32009c9f4a3adcff4e29c3eecac7851898206af5ecd"
# The updater's current snapshot (a symlink it swaps).
db_root = "/var/lib/pigeonpost-scandb/current"
# Older databases fail the scan (the updater runs every 6 hours).
max_db_age_hours = 72
timeout_secs = 900
memory_mib = 4096

# The observed behaviour run: the egress trace and the resource budget.
[behaviour]
# Mapped to /usr/local/bin/runsc-behaviour in containers.conf.
runtime = "runsc-behaviour"
trace_root = "/var/lib/pigeonpost-buildd/netlog"
# nestbuild's user manager cgroup (2350 = its uid): every rootless container runs under it.
cgroup = "/sys/fs/cgroup/user.slice/user-2350.slice/user@2350.service"

# The marketplace pool's per-Nest limits (nestd.toml [marketplace_pool]): over is advisory,
# more than twice over blocks.
[behaviour.budget]
memory_mib = 1024
cpu_millis = 1000
job_seconds = 60

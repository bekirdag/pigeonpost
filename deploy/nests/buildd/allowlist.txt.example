# /etc/pigeonpost-buildd/allowlist.txt — the only names the build plane may reach on TCP 443.
# Git hosts must match [git].allowed_hosts in buildd.toml; the package registries are needed by
# the fetch step (`cargo vendor --locked` against Cargo.lock checksums, `npm ci` against
# package-lock.json integrity, `pip download --require-hashes` against requirements.txt hashes).
github.com
codeload.github.com
codeberg.org
index.crates.io
static.crates.io
crates.io
registry.npmjs.org
pypi.org
files.pythonhosted.org

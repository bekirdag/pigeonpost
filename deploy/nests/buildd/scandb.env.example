# /etc/pigeonpost-buildd/scandb.env — read by nestscan-update. The same pinned images as
# buildd.toml's [scanners] (loaded into nestscan's podman storage too).
SCANNER_IMAGE=localhost/pigeonpost-scanners:2026.11@sha256:<DIGEST>
CLAMAV_IMAGE=docker.io/clamav/clamav:1.4.6_base@sha256:109477fb9dedf7b4542d0fc7be7f8ef73a55d9d731e9568821347825219407aa
# Optional overrides:
# SCANDB_ROOT=/var/lib/pigeonpost-scandb
# UPDATE_NETWORK=nestscan-update
# OSV_ECOSYSTEMS="crates.io npm PyPI"
# YARA_FORGE_URL=https://github.com/YARAHQ/yara-forge/releases/latest/download/yara-forge-rules-core.zip

# /etc/nests/backup.env (0600 root) — read by nests-backup and nests-restore. No secrets here:
# the passphrase and the borg key live in /etc/nests/backup/ (0700 root), with one copy on the
# owner's Mac. See docs/nests/backups.md.
BORG_REPO=ssh://nestsbak@10.68.0.2:2222/mnt/backups/nests/repo
BORG_RSH="ssh -i /etc/nests/backup/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/nests/backup/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20"
BORG_KEYS_DIR=/etc/nests/backup/keys
BORG_PASSCOMMAND="cat /etc/nests/backup/passphrase"
BORG_BASE_DIR=/var/lib/nests/borg

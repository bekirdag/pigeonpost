# /etc/nests/nestd.toml — Nests Phase A on nests-1. No secrets in this file.
db = "/var/lib/nests/ledger/nestd.db"

[control]
# WireGuard address facing the postbox host only. Never a public address.
bind = "10.66.0.2:8790"
# SHA-256 (hex) of POSTBOX_NESTS_TOKEN; the token itself lives only on the postbox host.
token_sha256_file = "/etc/nests/control-token.sha256"
idle_stop_secs = 900
# Admission: resident Nests (running or paused). 15 x (256 MiB limit + ~1 MiB host overhead)
# fits the ~4.8 GiB the VMware balloon leaves this guest, with headroom; see phase-a-plan.md §5.
max_running = 15
reconcile_secs = 60
# Phase B6: Prometheus metrics on loopback (scraped by the local Prometheus), and the backup's
# success marker exported as nests_backup_last_success_seconds.
metrics_bind = "127.0.0.1:9790"
backup_marker = "/var/lib/nests/backup-last-success"

[sandbox]
runtime = "gvisor"
oci_runtime = "runsc-nests"
# Pinned by digest; set by deploy/nests/runner/build.sh.
image = "localhost/pigeonpost-nest-runner@sha256:REPLACE"
network = "nests"
memory_mib = 256
cpu_weight = 100
cpu_max_millis = 1000
pids = 128
tmp_mib = 64
postbox_host = "postbox.pigeonpost.dev"
postbox_ip = "45.132.181.100"
postbox_url = "https://postbox.pigeonpost.dev"
broker_ip = "10.67.255.1"
broker_port = 8788

# The marketplace pool (M0): gVisor, a separate network and volumes, one sandbox per buyer context.
# Off when this table is absent; nestd does not use it until M1. deploy/nests/README.md has the setup.
# [sandbox.marketplace]
# image = "localhost/pigeonpost-marketplace-worker@sha256:REPLACE"
# network = "nests-mp"
# volume_root = "/var/lib/nests/mp"
# broker_ip = "10.67.255.1"
# broker_port = 8788
# memory_mib = 256
# cpu_max_millis = 500
# pids = 64
# tmp_mib = 32
# Hardening (W1): the postbox attestation public key(s), 64 hex digits each. Required for a
# production pool; two entries while a key rotation is in progress.
# attestation_keys = ["<64-hex Ed25519 public key>"]
# Each buyer worker gets a LUKS2 thin volume of this size (storage.backend must be lvm-luks).
# worker_gib = 1
# Release images this host lacks are pulled by digest from the build plane (deploy/nests/buildd).
# [sandbox.marketplace.artifacts]
# url = "http://<BUILD_WG_ADDR>:8795"
# token_file = "/etc/nests/buildd-artifact.token"
# cache_dir = "/var/lib/nests/artifacts"
# max_bytes = 4294967296

[storage]
backend = "lvm-luks"
vg = "nests"
pool = "pool"
mount_root = "/var/lib/nests/mnt"
key_dir = "/var/lib/nests/keys"
default_gib = 5
# Thin pool is 62.6 GiB; no overcommit.
max_total_gib = 60
sandbox_uid = 10001
# Phase B6: volume keys are stored wrapped under the host KEK, which only the postbox holds and
# releases over WireGuard (POST /v1/unlock). Until then nestd is locked: nothing starts.
key_wrap = true

[broker]
bind = "10.67.255.1:8788"
# mswarm (OpenAI-compatible, key sent as x-api-key). The key is in /etc/nests/upstream.key (0600
# root), handed to the broker by systemd LoadCredential. Owner decision 2026-11-04: the self-hosted
# load balancer route with the qwen-latest-flash-next load-balanced alias (cost 0). List the
# aliases with GET https://api.mswarm.org/v1/swarm/self-hosted/agents?include_load_balanced=true
# The plain model id "qwen-latest-flash-next" load-balances across whichever self-hosted nodes
# serve it. Use it rather than a hashed `mswarm-lb-…` alias: on 2026-11-10 the alias set here
# before (…-9dcea7b3d996) had disappeared and the broker got 404 no_compatible_agent. For a local test without mswarm, use the
# mock: http://127.0.0.1:8789/v1/chat/completions and `systemctl start nestd-mock-upstream`.
upstream_url = "https://api.mswarm.org/v1/swarm/self-hosted/openai/load-balanced/chat/completions"
upstream_key_file = "/run/credentials/nestd-broker.service/upstream.key"
model = "qwen-latest-flash-next"
max_input_tokens = 16384
max_output_tokens = 1024
upstream_timeout_secs = 120
# Operator spend caps, monthly tokens. Each Nest gets the lower of its own allowance and the
# per-Nest cap; all Nests together stop at the global cap (reserved, used and unknown-outcome
# tokens all count). Refusals are 429 `allowance_exhausted` / `platform_limit`. Omit one for no cap.
# The self-hosted route costs nothing today; the caps still bound load on the self-hosted pool and
# keep spend bounded if the upstream is switched to a paid cloud model (e.g. deepseek/deepseek-v4-flash
# on https://api.mswarm.org/v1/chat/completions).
nest_monthly_input_cap = 1000000
nest_monthly_output_cap = 100000
global_monthly_input_cap = 5000000
global_monthly_output_cap = 500000

# Phase B6: Alertmanager's webhook relayed as a Pigeonpost message (pigeonpost-nestd alert-relay).
[alerts]
bind = "127.0.0.1:9796"
postbox_url = "https://postbox.pigeonpost.dev"
token_file = "/run/credentials/nests-alert-relay.service/alerts.token"
to = "/bekir"

# Optional Postmark fallback through Postmark: used when the postbox send fails (connection error,
# timeout, 5xx) and always for Postbox* alerts. The server token is /etc/credstore/postmark.token
# (root 0400), handed over by systemd LoadCredential. Remove this section to disable it.
[alerts.postmark]
token_file = "/run/credentials/nests-alert-relay.service/postmark.token"
from = "alerts@pigeonpost.dev"
to = "REPLACE-operator@example.com"
message_stream = "outbound"

# /etc/pigeonpost-tunnel.env (0600 root). Never commit the real token.
# Phase 9: a Unix socket only nginx (group www-data, gid 33 on raijin) can reach. X-Real-IP is
# trusted only on this socket; over TCP it is ignored.
TUNNEL_BIND=unix:/run/pigeonpost-tunnel/broker.sock
TUNNEL_SOCKET_GID=33
# The postbox internal API through the existing private tunnel (pigeonpost-postbox-tunnel.service).
TUNNEL_POSTBOX_INTERNAL_URL=http://127.0.0.1:18991
# Must equal POSTBOX_SVC_TOKEN_TUNNEL in the postbox's postbox.env (svc_ + 64 hex).
TUNNEL_SERVICE_TOKEN=svc_REPLACE_ME
TUNNEL_TRUST_PROXY=1
TUNNEL_MAX_SESSIONS=200
TUNNEL_PER_IP_PER_MINUTE=120
RUST_LOG=info

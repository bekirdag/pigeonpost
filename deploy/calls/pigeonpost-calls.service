[Unit]
Description=Pigeonpost calls (signaling and TURN credentials for web calls)
After=network-online.target
Wants=network-online.target

[Service]
User=pigeonpost-calls
Group=pigeonpost-calls
EnvironmentFile=/etc/pigeonpost-calls/calls.env
ExecStart=/usr/bin/node /opt/pigeonpost-calls/src/server.js
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target

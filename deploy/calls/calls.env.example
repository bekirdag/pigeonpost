# /etc/pigeonpost-calls/calls.env — mode 0640 root:pigeonpost-calls. Never commit the real file.
CALLS_HOST=127.0.0.1
CALLS_PORT=8795
CALLS_POSTBOX_URL=https://postbox.pigeonpost.dev
CALLS_ALLOWED_ORIGINS=https://inbox.pigeonpost.dev
# Same value as coturn's static-auth-secret on the relay. Generate on the relay; copy host to host.
CALLS_TURN_SECRET=__REPLACE_ON_HOST__
CALLS_TURN_URLS=turn:RELAY_IP:3478?transport=udp,turn:RELAY_IP:3478?transport=tcp
CALLS_TURN_TTL_SECONDS=21600
# Phase 1b: the postbox's internal API (call admission and call history), reached through the
# private tunnel on raijin (see deploy/postbox). Unset = ring without asking, report nothing.
POSTBOX_INTERNAL_URL=http://127.0.0.1:18991
# The calls service's own token (svc_…), matching POSTBOX_SVC_TOKEN_CALLS on the postbox.
POSTBOX_SERVICE_TOKEN=__REPLACE_ON_HOST__

# Large calls (7–30 people) on the media server. Leave CALLS_SFU_URL empty to keep every call a mesh of six.
# Where browsers reach the media server's signaling: through the inbox's own origin (see
# nginx-inbox-sfu.conf), so the inbox's CSP needs no change.
CALLS_SFU_URL=wss://inbox.pigeonpost.dev/sfu
# The media server's admin API (remove participants, close rooms), over TLS that trusts one certificate.
CALLS_SFU_API_URL=https://MEDIA_HOST_IP:7443
CALLS_SFU_API_CA_FILE=/etc/pigeonpost-calls/sfu-backhaul.crt
CALLS_SFU_API_SERVERNAME=sfu-backhaul.pigeonpost.internal
# Same key and secret as LIVEKIT_KEYS on the media host. Generate there; copy host to host.
CALLS_SFU_KEY=__REPLACE_ON_HOST__
CALLS_SFU_SECRET=__REPLACE_ON_HOST__
CALLS_SFU_TOKEN_TTL_SECONDS=120
# Planned upload of the media host in Mbit/s; see "Capacity" in README.md before changing it.
CALLS_SFU_BUDGET_MBPS=400

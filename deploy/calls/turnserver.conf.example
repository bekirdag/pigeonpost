# /etc/turnserver.conf on the relay — mode 0640 root:turnserver. RELAY_IP and the secret are host values.
listening-port=3478
external-ip=RELAY_IP
relay-ip=RELAY_IP
min-port=49160
max-port=59999
realm=pigeonpost.dev
fingerprint
use-auth-secret
static-auth-secret=__GENERATED_ON_HOST__
total-quota=1200
user-quota=60
max-bps=1000000
stale-nonce=600
max-allocate-lifetime=3600
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
no-cli
no-tlsv1
no-tlsv1_1
no-software-attribute
simple-log
log-file=/var/log/turnserver/turn.log
proc-user=turnserver
proc-group=turnserver

# Enable after issuing the certificate and installing restricted copies with the renewal hook.
# An auxiliary TCP listener supports TLS on 443 even when RFC5780 is disabled on a single-IP host.
# Binding 443 requires the pigeonpost-tls.conf systemd drop-in described in README.md.
# tls-listening-port=5349
# aux-server=RELAY_IP:443
# cert=/etc/turnserver-tls/current/fullchain.pem
# pkey=/etc/turnserver-tls/current/privkey.pem
# no-dtls

# /etc/pigeonpost-meeting-intel/meeting-intel.env (root:root 0600). No secrets in the repo.
INTEL_HOST=127.0.0.1
INTEL_PORT=8797
# The calls service's token for this service (CALLS_INTEL_TOKEN on the calls side). 32+ random characters.
INTEL_SERVICE_TOKEN=__REPLACE_ON_HOST__
# whisper.cpp server (pigeonpost-whisper.service).
INTEL_WHISPER_URL=http://127.0.0.1:8798/inference
INTEL_STT_NAME=whisper.cpp v1.9.5 small
INTEL_FFMPEG=/usr/bin/ffmpeg
# A local OpenAI-compatible model on this host. No cloud fallback: if it is down the brief is a
# marked draft (transcript only).
INTEL_LLM_URL=http://127.0.0.1:11452/v1/chat/completions
INTEL_LLM_MODEL=qwen-latest-flash-next
# The postbox's internal API through the existing tunnel, with the meeting_intel service token
# (POSTBOX_SVC_TOKEN_MEETING_INTEL on the postbox).
POSTBOX_INTERNAL_URL=http://127.0.0.1:18991
POSTBOX_SERVICE_TOKEN=__REPLACE_ON_HOST__

# Copy to postbox.env and fill in. Keep postbox.env at 600 and NEVER commit it (see .gitignore).
# Scaffold reads only the non-secret vars below; the secret vars are placeholders for the P0+ build.

# --- service (host: 159.69.201.24) ---
POSTBOX_BIND=0.0.0.0:8990
POSTBOX_PUBLIC_URL=https://postbox.pigeonpost.dev
POSTBOX_LOFT_DIR=/data/loft

# --- database (P0: bundled SQLite on the data volume; Postgres is the P2 swap) ---
POSTBOX_DB_PATH=/data/postbox.db

# --- key vault (P2) ---
POSTBOX_KMS=sealed-file:/kms/master.age

# --- identity / OAuth (P1) ---
OIDC_ISSUER=https://auth.pigeonpost.dev/realms/pigeonpost-prod
OIDC_AUDIENCE=masaas-api
OIDC_CLIENT_ID=pigeonpost-postbox

# --- registry ---
REGISTRY_URL=https://registry.pigeonpost.dev

# --- anti-abuse (§14.1) ---
POW_MIN_BITS=18
POW_MAX_BITS=26
POW_HMAC_SECRET=CHANGEME
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=CHANGEME

# --- quotas / retention ---
EPHEMERAL_RETENTION_DAYS=30
# An account is one operator's fleet, not the abuse boundary — the per-IP mint budget below is.
EPHEMERAL_MAX_IDENTITIES=50
EPHEMERAL_QUOTA_MB=100
POSTBOX_QUOTA_MB=1024
REAPER_INTERVAL_SECS=3600

# --- per-IP mint budget (unauthenticated /v1/identities and /v1/accounts) ---
# A small burst so one box can onboard a handful of agents at once, then a steady drip.
MINT_PER_IP_WINDOW=5
MINT_WINDOW_SECS=3600
MINT_PER_IP_LIFETIME=1000
# REQUIRED HERE: Apache fronts this container, so the socket peer is the proxy. With 0, every
# caller shares one budget and the whole internet is throttled after five mints. 1 = trust the
# last X-Forwarded-For hop, which is the address our own Apache observed.
TRUSTED_PROXY_HOPS=1

# Shared secret the billing/entitlement service presents to PUT /v1/namespaces, binding a
# purchased handle namespace to an account. Leave unset and the endpoint answers 404: an
# unconfigured deployment must not hand out paid namespaces to whoever asks.
# NAMESPACE_GRANT_TOKEN=CHANGEME

# --- attachments ---
# Unset PIGEONPOST_BLOB_DIR closes both attachment endpoints: a postbox with nowhere to put bytes
# should refuse files clearly rather than accept them and lose them. The other two bound what the
# whole store may claim of a shared volume, and what it must leave for everyone else on it.
# PIGEONPOST_BLOB_DIR=/mnt/web-volume/pigeonpost-blobs
# PIGEONPOST_BLOB_MAX_MB=100
# PIGEONPOST_BLOB_TOTAL_MB=12288
# PIGEONPOST_BLOB_MIN_FREE_MB=2048

# Shared secret a monitor presents to scrape GET /metrics. Unset closes the route, the same way an
# unconfigured namespace grant closes itself — what a deployment is storing is operational detail.
# POSTBOX_METRICS_TOKEN=CHANGEME
